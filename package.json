{
  "name": "solectrus",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "lint": "eslint --cache .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@formkit/auto-animate": "^0.10.2",
    "@honeybadger-io/js": "^6.17.2",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@plausible-analytics/tracker": "^0.4.7",
    "chart.js": "^4.6.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-crosshair": "^2.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/luxon": "^3.7.6",
    "@types/sinon": "^22.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.65.1",
    "rails-vite-plugin": "^0.4.0",
    "sinon": "^22.1.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4"
  },
  "resolutions": {
    "typescript": "^6"
  },
  "size-limit": [
    {
      "name": "App",
      "limit": "215 kB",
      "gzip": true,
      "path": [
        "public/vite/assets/*.js",
        "!public/vite/assets/maplibre-*.js",
        "!public/vite/assets/honeybadger-*.js"
      ]
    },
    {
      "name": "Map (car page only)",
      "limit": "460 kB",
      "gzip": true,
      "path": "public/vite/assets/maplibre-*.js"
    }
  ],
  "engines": {
    "bun": "1.4.x"
  }
}
