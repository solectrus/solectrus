# Keeps out of the Docker image what only development, test and CI need.
#
# The image runs production alone (see config/docker_image.rb). Files the build
# needs but production does not, like package.json, cannot go here. The
# Dockerfile removes them after the build.

# Version control and repository metadata
.git
.gitattributes
.github
.gitignore
.dockerignore
Dockerfile

# Editor, linter and tool configuration
.annotaterb.yml
.eslintcache
.prettierignore
.prettierrc.json
.rspec
.rubocop.yml
.ruby-lsp
.simplecov
.slim-lint.yml
.vscode
bunfig.toml
eslint.config.mjs
Guardfile
**/*.DS_Store

# Local environment and process setup
.bundle
.env*
Brewfile
Caddyfile
compose.yaml
Procfile*

# Documentation and assets for the repository page
.changelog
AGENTS.md
docs
logo.svg
screenshot.webp

# Development, test and CI tooling
bin/brakeman
bin/bundler-audit
bin/ci
bin/dev
bin/image-test.sh
bin/influxdb-restart.sh
bin/llm-test
bin/open
bin/preview-rebuild
bin/rspec
bin/rubocop
bin/setup
bin/slim-lint
config/brakeman.ignore
config/bundler-audit.yml
config/ci
config/ci.rb
script
spec

# The image carries the configuration of production alone. Started under any
# other name, it stops at boot (see config/docker_image.rb).
config/environments/development.rb
config/environments/test.rb

# Initializers that do something in development only
config/initializers/helios_check_simulation.rb
config/initializers/sensors.rb
config/initializers/update_check_simulation.rb

# Icon generator, the image reads config/icons.generated.yml
config/icons.yml
lib/icon_generator.rb
lib/tasks/icons.rake

# Other development-only Rake tasks and settings
config/rorvswild.yml
lib/tasks/annotate_rb.rake
lib/tasks/coverage.rake

# Local build output, logs and temporary files. The directories stay, with
# their .keep files, but not what a local run wrote into them.
coverage
log/*
node_modules
public/vite*
tmp/*
!tmp/pids/
tmp/pids/*
!tmp/pids/.keep
