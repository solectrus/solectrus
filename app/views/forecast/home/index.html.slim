- turbo_exempts_page_from_cache
- content_for :full_height, true
- extra_stimulus_controllers 'swipe'

- content_for :sub_nav do
  / A phone has the timeframe in one row, as the home pages have it (see
    Timeframe::Segments::Component)
  .pb-3.lg:landscape:hidden
    = render Timeframe::Segments::Component.new(**segment_items)

  .hidden.lg:landscape:flex.items-center.justify-between.py-5
    = tag.turbo_frame id: 'forecast-second-nav', target: '_top' do
      = render Nav::Sub::Component.new do |c|
        - c.with_items nav_items

    - if days
      = tag.turbo_frame id: 'forecast-timeframe',
                        target: '_top',
                        class: 'h-8 space-x-4 flex flex-1 items-center justify-end' do
        = render Timeframe::Component.new(timeframe:, forecast_days: days)

= render Forecast::Component.new(days:)
