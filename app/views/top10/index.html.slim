- turbo_exempts_page_from_cache
- content_for :grouped, true

- content_for :sub_nav do
  .pt-2.pb-3.lg:landscape:flex.lg:landscape:items-center.lg:landscape:justify-between.lg:landscape:py-5
    .flex.flex-col.gap-2.lg:landscape:gap-0
      / The icon names the page on a phone, unless a title bar does
      - unless more_child_item
        .flex.items-center.justify-center.min-h-10.lg:landscape:hidden
          = icon 'trophy', class: 'text-indigo-200 dark:text-gray-400 text-2xl'
      = render Nav::Sub::Component.new(abbreviate: false) do |c|
        - c.with_items nav_items

    / The same two buttons as on a phone: the sensor and the options
    .hidden.lg:landscape:flex.gap-3.items-center.justify-end.text-base.h-9
      = render Top10::SensorSelect::Component.new(current_sensor: sensor, permitted_params:)
      = render Top10::Options::Component.new(sensor:, calc: (calc if supports_calc_select?), permitted_params:)

/ A phone has the choices above the list, as the charging sessions have
  theirs: white buttons on the gray page, in one line. The sensor stands at
  the left and gives way where the line is narrow. The options stand at the
  right. They answer a tap themselves, so they stay lit while the next page
  loads (see application.css).
.ui-keep-lit.flex.items-center.gap-3.mb-4.lg:landscape:hidden
  .min-w-0 class='*:min-w-0'
    = render Top10::SensorSelect::Component.new(current_sensor: sensor, permitted_params:, phone: true)
  .ml-auto.shrink-0
    = render Top10::Options::Component.new(sensor:, calc: (calc if supports_calc_select?), permitted_params:, phone: true)

- if @missing_or_stale_summary_days.present?
  = render Summary::Builder::Component.new(timeframe:, missing_or_stale_days: @missing_or_stale_summary_days)

- else
  = render Ui::LazyFrame::Component.new id: "top10-#{period}-#{sensor_name}-#{sort}-#{calc}",
                                        src: top10_chart_path(permitted_params.to_hash.symbolize_keys),
                                        class: 'min-h-96 flex flex-col',
                                        target: '_top',
                                        data: { turbo_permanent: true }
