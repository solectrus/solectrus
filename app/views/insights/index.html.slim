= render TurboModal::Component.new do |modal|
  - modal.with_title do
    .flex.gap-3.items-center
      = render SensorIcon::Component.new(sensor)
      = sensor.display_name

  .mt-2.mb-4
    = timeframe.localized

  - if ApplicationPolicy.insights? && sensor.is_a?(Sensor::Definitions::CarPageChart)
    = render Car::Insights::Component.new(sensor:, timeframe:, car: params[:car])
  - elsif ApplicationPolicy.insights?
    = render Insights::Component.new(sensor:, timeframe:, controller_namespace:)
  - else
    = render DemoLink::Component.new feature: 'insights',
                                     url: { controller: 'balance/home', timeframe: params[:timeframe] }
