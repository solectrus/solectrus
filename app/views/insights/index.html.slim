- insights = Insights::Component.new(sensor:, timeframe:, controller_namespace:)

= render TurboModal::Component.new(width: :medium) do |modal|
  - modal.with_title do
    / One row for name, period and total, so the list starts high up
    .insights-heading
      = render SensorIcon::Component.new(sensor)
      .min-w-0.flex-1
        .truncate = sensor.display_name
        .insights-heading-period = timeframe.localized
      - if (total = insights.heading_total)
        = render total

  = render insights

  / In place of the figures that need the permission
  - unless insights.permitted?
    = render DemoLink::Component.new(feature: 'insights', url: { controller: 'balance/home', timeframe: params[:timeframe] })
