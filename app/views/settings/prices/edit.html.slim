- heading = t("settings.prices.edit.#{name}")
= render 'settings/sub_nav', title: heading, back_href: list_path, back_label: title, save: form_page_id(@price)

= render Ui::FormPage::Component.new(title: heading, title_mark: render(OriginNote::Component.new(record: @price, inline: true)), form: form_page_id(@price)) do
  = render 'form', price: @price
