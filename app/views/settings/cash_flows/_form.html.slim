= form_page_with(model: cash_flow, url: cash_flow.persisted? ? settings_cash_flow_path(cash_flow) : settings_cash_flows_path) do |f|
  = f.group do
    = f.date_field :date, autofocus: true
    = f.select :category,
               CashFlow.categories.keys.map { |key| [CashFlow.human_enum_name(:category, key), key] },
               { hint: t('settings.cash_flows.category_hint') }
    = f.number_field :amount,
                     step: '0.01',
                     label: t('activerecord.attributes.cash_flow.amount_with_currency', currency: Currency.symbol),
                     hint: t('settings.cash_flows.amount_hint')
    = f.text_field :note

  = render Ui::SubmitButton::Component.new delete_path: (settings_cash_flow_path(cash_flow) if cash_flow.persisted?)
