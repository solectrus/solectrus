- categories = CashFlow.categories.keys.map { |key| [CashFlow.human_enum_name(:category, key), key] }

= form_page_with(model: cash_flow, url: cash_flow.persisted? ? settings_cash_flow_path(cash_flow) : settings_cash_flows_path) do |f|
  = f.group footer: t('settings.cash_flows.amount_hint') do
    = f.date_field :date, autofocus: true
    = f.number_field :amount, step: '0.01', currency: true

  = f.group footer: t('settings.cash_flows.category_hint') do
    = f.select :category, categories

  = f.group do
    = f.text_field :note

  = render Ui::SubmitButton::Component.new delete_path: (settings_cash_flow_path(cash_flow) if cash_flow.persisted?)
