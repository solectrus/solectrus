= form_with(model: cash_flow, url: cash_flow.persisted? ? settings_cash_flow_path(cash_flow) : settings_cash_flows_path, id: dom_id(cash_flow, :form), html: { data: { controller: 'form-dirty' } }) do |f|
  = f.group do
    = f.date_field :date,
                   autofocus: true
    = f.select :category,
               CashFlow.categories.keys.map { |key| [CashFlow.human_enum_name(:category, key), key] },
               { hint: t('settings.cash_flows.category_hint') }
    = f.number_field :amount,
                     step: '0.01',
                     label: t('activerecord.attributes.cash_flow.amount_with_currency', currency: Currency.symbol),
                     hint: t('settings.cash_flows.amount_hint')
    = f.text_field :note

  .flex.items-center.justify-end
    / The delete button submits this form as a DELETE to the record instead.
    - if cash_flow.persisted?
      = render Button::Component.new icon: 'trash',
                                     type: :submit,
                                     style: :secondary,
                                     options: { \
                                       formaction: settings_cash_flow_path(cash_flow),
                                       formmethod: :delete,
                                       formnovalidate: true,
                                       title: t('crud.delete'),
                                       'aria-label': t('crud.delete'),
                                       data: { \
                                         turbo_confirm: t('crud.confirm_delete'),
                                         controller: 'tooltip',
                                         tooltip_placement_value: 'right',
                                       },
                                       class: 'mr-auto text-gray-500 dark:text-gray-400 hover:text-orange-500 dark:hover:text-orange-500',
                                     }
    = render 'settings/fab_submit'
