= render 'settings/sub_nav'

.flex.items-start.justify-between.gap-4.mb-8.px-2
  .flex-1.min-w-0
    p.text-gray-500.text-sm.md:text-base
      = t 'settings.cash_flows.description'

    /! Who may see the amortization calculation: everyone, admins only, or nobody
    /! (the page disappears from the navigation entirely). Sits right under the
    /! intro so it reads as part of the explanation. The "all" option exposes the
    /! calculation to non-admins and is a sponsor feature, so it is disabled
    /! otherwise.
    = form_with model: Setting.new, url: visibility_settings_cash_flows_path, method: :patch, html: { class: 'mt-3' }, data: { controller: 'auto-submit' } do |f|
      - current_visibility = Setting.enable_amortization ? (Setting.amortization_public ? 'all' : 'admins') : 'none'
      - visibility_choices = [[t('settings.cash_flows.visibility_all'), 'all'], [t('settings.cash_flows.visibility_admins'), 'admins'], [t('settings.cash_flows.visibility_none'), 'none']]
      = f.select :amortization_visibility,
                 options_for_select(visibility_choices, selected: current_visibility, disabled: (ApplicationPolicy.amortization? ? nil : 'all')),
                 { label: t('settings.cash_flows.visibility_label'), hint: (t('settings.cash_flows.sponsors_only') unless ApplicationPolicy.amortization?) },
                 { class: 'max-w-xs', data: { action: 'change->auto-submit#submit' } }

  = button_to new_settings_cash_flow_path,
              method: :get,
              data: { turbo_frame: 'modal', controller: 'modal-launcher' },
              class: 'size-14 shrink-0 rounded-full bg-indigo-600 dark:bg-indigo-800 text-white shadow-lg hover:bg-indigo-700 click-animation focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2',
              title: t('crud.new') do
    i.fa.fas.fa-plus.fa-lg

/! Interactive filter: narrow the list by category and/or date range (also the
/! landing spot when drilling down from the amortization table). Kept outside the
/! 'list' frame so a list refresh does not drop it.
= render CashFlowFilter::Component.new

= tag.turbo_frame id: 'list' do
  = render 'list', cash_flows: @cash_flows, filter_categories:, filter_from:, filter_to:
