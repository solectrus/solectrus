/ One level below the sensors on a phone, a tab beside the other groups on
  the desktop
= render 'settings/sub_nav',
         title: @section[:name],
         back_href: settings_sensors_path,
         back_label: t('settings.sensors.name'),
         save: 'settings_sensors_form',
         save_bar: 'settings_sensors_form'

= render Nav::Side::Component.new(items: sensor_sections) do
  = render layout: 'settings/sensors/form' do |f|
    = render "settings/sensors/#{@section[:id]}", f:
