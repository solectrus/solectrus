= render 'settings/sub_nav'

= form_with(model: Setting.new, url: settings_general_path, method: :patch, html: { class: 'relative px-2', data: { controller: 'form-dirty' } }) do |f|
  = f.group do
    = f.text_field :plant_name,
                   value: Setting.plant_name,
                   placeholder: t('settings.general.plant.plant_name.placeholder'),
                   autofocus: true

    = f.text_field :operator_name,
                   value: Setting.operator_name,
                   placeholder: t('settings.general.plant.operator_name.placeholder')

  = f.group title: t('settings.general.mcp.title') do
    - if ApplicationPolicy.mcp?
      = f.check_box :mcp_enabled,
                    checked: Setting.mcp_enabled,
                    label: t('settings.general.mcp.enable'),
                    hint: t('settings.general.mcp.hint')

      - if McpOauth.available?
        p.ps-7.-mt-3.text-xs.text-gray-500.dark:text-gray-400
          = t('settings.general.mcp.endpoint')
          = ' '
          = link_to mcp_url,
                    mcp_url,
                    class: 'font-mono text-indigo-600 dark:text-indigo-400 hover:underline break-all',
                    target: '_blank',
                    rel: 'noopener'
    - else
      = f.check_box :mcp_enabled,
                    checked: false,
                    disabled: true,
                    label: t('settings.general.mcp.enable'),
                    hint: t('premium.sponsors_only')

  .sticky.bottom-4.z-20.flex.justify-end
    = render 'settings/fab_submit'

.mt-10.px-2
  = render 'summaries', summary_completion_rate: @summary_completion_rate
