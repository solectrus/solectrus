= render 'settings/sub_nav'

= render Ui::SideNav::Component.new(items: car_nav_items) do
  / A stream refreshes the list. The link of a row on a phone leaves the frame.
  = tag.turbo_frame id: 'list', target: '_top' do
    = render Car::List::Component.new(cars: @cars)

  / The payments and the places are a group below the cars on a phone, tabs
    on the desktop
  ruby:
    icons = { settings_car_payments_path => 'hand-holding-dollar', settings_places_path => 'location-dot' }
    pages = car_nav_items.drop(1).map { it.merge(icon: icons[it[:href]]) }
  - if pages.any?
    .mt-8.lg:hidden
      = render Ui::NavList::Component.new(items: pages, label: t('settings.cars.name'))
