= render 'settings/sub_nav', save: 'settings_system_form', save_bar: 'settings_system_form'

= form_with(model: Setting.new, url: settings_system_path, method: :patch, id: 'settings_system_form', html: { class: 'ui-form relative px-2', data: page_form_data }) do |f|
  = render Ui::SectionHeader::Component.new(title: t('settings.system.mcp.title'), class: 'mb-4 max-lg:mb-0')
  = f.group flush: true do
    - if ApplicationPolicy.mcp?
      = f.check_box :mcp_enabled,
                    checked: Setting.mcp_enabled,
                    label: t('settings.system.mcp.enable'),
                    hint: t('settings.system.mcp.hint')

      - if McpOauth.available?
        p.ps-7.-mt-3.text-xs.text-gray-500.dark:text-gray-400
          = t('settings.system.mcp.endpoint')
          = ' '
          = link_to mcp_url,
                    mcp_url,
                    class: 'font-mono text-indigo-600 dark:text-indigo-400 hover:underline break-all',
                    target: '_blank',
                    rel: 'noopener'
    - else
      = f.check_box :mcp_enabled,
                    checked: false,
                    disabled: true,
                    label: t('settings.system.mcp.enable'),
                    hint: t('premium.sponsors_only')

.mt-8.lg:mt-10.px-2.max-lg:px-0
  = render Summary::Status::Component.new(completion_rate: @summary_completion_rate)
