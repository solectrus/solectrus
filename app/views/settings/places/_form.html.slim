= form_page_with(model: place, url: settings_place_path(place)) do |f|
  / The switch for home only while no other place is home (see
    Settings::PlacesController#home_switch?)
  = f.group do
    = f.text_field :name, autofocus: true
    - if home_switch?
      = f.check_box :home, label: Place.human_label('home'), hint: t('places.label_hints.home')

  = render Ui::SubmitButton::Component.new
