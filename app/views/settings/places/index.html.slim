= render layout: 'settings/cars/pages' do
  - if sponsored?
    = render VisitsBuild::Component.new(timeframe: build_timeframe, pending_days: @pending_days) do
      = render PlaceList::Component.new(places: @places, pagy: @pagy)
  - else
    = render DemoLink::Component.new(feature: Sensor::HomePage.feature(:cars))
