- heading = t('settings.places.edit')
= render 'settings/sub_nav', title: heading, back_href: list_path, back_label: title

/ The address and the map show the user which place this is. The modal
  names the address as its title, the page of a phone above the map.
= render Ui::FormPage::Component.new(title: @place.address || heading) do
  - if @place.address && !form_in_modal?
    p.lg:hidden.px-4.text-sm.text-muted class='pb-1.5' = @place.address
  div class='flex h-64 my-4 max-lg:mt-0 max-lg:mb-8 max-lg:overflow-hidden max-lg:rounded-xl'
    = render Car::Map::Component.new(cars: map_cars, live: true)
  = render 'form', place: @place

  / The form asked Nominatim, so the list gets the locality. A stream
    inside the frame runs when the modal opens. The page of a phone leads
    back to a snapshot of the list, so the stream drops the snapshots.
  - if @place.saved_change_to_geocoding?
    = safe_join(replace_place(@place))
    = turbo_stream.action(:clear_cache, nil)
