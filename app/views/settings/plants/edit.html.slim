= render 'settings/sub_nav', save: 'settings_plant_form', save_bar: 'settings_plant_form'

= render Nav::Side::Component.new(items: plant_nav_items) do
  = form_with(model: Setting.new, url: settings_plant_path, method: :patch, id: 'settings_plant_form', html: { class: 'ui-form relative px-2', data: page_form_data }) do |f|
    / No autofocus: iOS would open the keyboard right at the slide
    = f.group do
      = f.text_field :plant_name,
                     value: Setting.plant_name,
                     placeholder: t('settings.plant.plant_name.placeholder')

      = f.text_field :operator_name,
                     value: Setting.operator_name,
                     placeholder: t('settings.plant.operator_name.placeholder')

  / The cash flows are a group below the data on a phone, a tab on the
    desktop
  .mt-8.lg:hidden
    = render Ui::NavList::Component.new(items: plant_nav_items.drop(1), label: t('settings.plant.name'))
