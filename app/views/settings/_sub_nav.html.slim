- content_for :fixed_nav, true
- content_for :sub_nav do
  - selected_href = (nav_items.find { |item| item[:current] } || nav_items.first)[:href]
  - menu_items = nav_items.map { |item| MenuItem::Component.new(name: item[:name], href: item[:href], id: item[:href], current: item[:current]) }
  .lg:py-5
    /! Mobile: cog + label + native select dropdown
    .dark:bg-slate-900.-mx-4.sm:-mx-6.px-4.sm:px-6.py-3.lg:hidden
      .flex.items-center.justify-between.gap-3
        .flex.items-center.gap-3.text-white.dark:text-gray-200
          i.fa.fa-gear.text-indigo-200.dark:text-gray-400.text-xl
          span.font-medium.text-lg = t('layout.settings')

        = render Dropdown::Component.new( \
            name: 'settings-nav',
            items: menu_items,
            selected: selected_href,
            menu_position: :center,
            button_class: 'text-white dark:text-gray-200',
          )

    /! Desktop: original pill buttons (unchanged)
    .hidden.lg:block
      = render Nav::Sub::Component.new(abbreviate: false) do |c|
        = c.with_items nav_items
