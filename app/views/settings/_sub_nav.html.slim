/! Locals: `title` and `back_href` override the title bar on a phone. By
/! default a section page names its section and leads back to the overview.
ruby:
  current_item = nav_items.find { |item| item[:current] }
  title = local_assigns[:title] || current_item&.dig(:name) || t('layout.settings')
  back_href = local_assigns[:back_href] || (settings_path if current_item)
  back_label = local_assigns[:back_label] || t('layout.settings')

- content_for :fixed_nav, true
- content_for :sub_nav do
  .lg:py-5
    .lg:hidden
      = render Nav::TitleBar::Component.new(title:, back_href:, back_label:)

    /! Desktop: original pill buttons (unchanged)
    .hidden.lg:block
      = render Nav::Sub::Component.new(abbreviate: false) do |c|
        - c.with_items(nav_items.map { |item| item.slice(:name, :href, :current) })
