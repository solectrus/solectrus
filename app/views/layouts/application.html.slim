doctype html
html class= html_theme_classes lang= I18n.locale style= chrome_background_style
  head
    meta charset="utf-8"

    title
      = ['SOLECTRUS', title.presence].compact.join(' | ')

    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="disabled-adaptations" content="watch"
    meta name="format-detection" content="telephone=no"
    meta name="apple-mobile-web-app-title" content="SOLECTRUS"
    meta name="apple-mobile-web-app-capable" content="yes"
    / A translucent status bar makes iOS 26 and later paint a band of frosted
      glass over the top 100 pixels of an installed web app, so the status bar
      stays readable over whatever scrolls below it. The band blurred the row
      the app puts there. light-content asks for the white status bar text that
      the dark app frame needs, and iOS paints no band for it. An older iOS does
      not know the value and falls back to a status bar it colors itself, which
      is what it does for every value except the translucent one.
      iOS reads this tag when the visitor adds the app to the home screen. An
      app that is already there keeps the band until it is added again.
    meta name="apple-mobile-web-app-status-bar-style" content="light-content"
    meta name="mobile-web-app-capable" content="yes"
    meta name="application-name" content="SOLECTRUS"
    = render Theme::Color::Component.new(chosen: chosen_theme)
    = render Theme::System::Component.new(chosen: chosen_theme)
    meta name="version" content= Rails.configuration.x.git.commit_version
    meta name="date" content= Rails.configuration.x.git.commit_time
    meta name="env" content= Rails.env
    meta name="author" content="Georg Ledermann"
    meta name="robots" content= "noindex, nofollow, noarchive"
    = turbo_refreshes_with method: :morph, scroll: :preserve

    - if Rails.configuration.x.honeybadger.api_key
      meta name="honeybadger-api-key" content= Rails.configuration.x.honeybadger.api_key

    link rel="manifest" href= manifest_path crossorigin="use-credentials"
    link rel="icon" type="image/png" sizes="196x196" href="/favicon-196.png"
    = render 'layouts/apple_touch_icons'

    = csrf_meta_tags
    = csp_meta_tag

    - if Rails.env.test?
      meta name="server-time" content= Time.current.to_i
      = vite_typescript_tag 'test', 'data-turbo-track': 'reload'
      = vite_stylesheet_tag 'test.css', 'data-turbo-track': 'reload', media: 'screen'
    / Ahead of the stylesheet, so the font starts downloading with it instead
    / of waiting for it to be parsed.
    = render FontPreload::Component.new
    = vite_typescript_tag 'application', 'data-turbo-track': 'reload'
    = vite_stylesheet_tag 'application.css', 'data-turbo-track': 'reload', media: 'screen'

    = yield :head

  / A fixed navigation wins over full height
  - fixed_nav = content_for?(:fixed_nav)
  - full_height = !fixed_nav && content_for?(:full_height)

  body.bg-chrome.select-none.font-sans.antialiased[
    class=[('max-lg:overflow-hidden' if fixed_nav), ('overflow-hidden' if full_height)]
    class=('theme-strip-collapsed' if !content_for?(:sub_nav) || fixed_nav)
    data-controller= ['fullscreen', content_for(:extra_stimulus_controllers), ('plausible' if Rails.configuration.x.plausible_url)].compact.join(' ')
    data-plausible-url-value= Rails.configuration.x.plausible_url
    data-plausible-domain-value= (Rails.configuration.x.plausible_url.present? ? Rails.configuration.x.app_host : nil)
  ]
    / Below lg the strip fits only above a sub navigation of full height. A page
      without one starts its content at the top edge, and a page with a fixed
      navigation carries a shorter header than the strip is high. Both carry
      theme-strip-collapsed on the body, which drops the strip to no height
      there. That class is on the body and not on the strip, because Turbo
      keeps the strip and the styles of the page that rendered it first.
    = render Theme::Strip::Component.new

    .flex.flex-col.min-h-dvh.bg-linear-to-t.from-gray-100.to-white.dark:from-black.dark:to-black class=[('max-lg:h-dvh max-lg:overflow-hidden' if fixed_nav), ('h-dvh overflow-hidden' if full_height)]
      - if banner?
        = render Banner::Component.new registration_status: UpdateCheck.registration_status,
                                       admin: admin?

      = render Nav::Top::Component.new(compact: fixed_nav, unread_count: unread_notifications_count) do |c|
        - c.with_primary_items desktop_primary_items
        - c.with_secondary_items desktop_secondary_items
        = c.with_sub_nav do
          / A page of the page More names itself with a title bar on a phone,
            and a page below it leads back there. Its own navigation follows
            as the accessory of the bar.
          - item = more_child_item
          - if item
            = render Ui::TitleBar::Component.new(title: item[:name], back_href: (more_path if item[:back]), back_label: t('layout.more'), back_logo: more_logo, plain: !content_for?(:grouped)) do |bar|
              - bar.with_action(**title_bar_action) if title_bar_action
              - bar.with_options { yield(:title_bar_options) } if content_for?(:title_bar_options)
          = item ? tag.div(yield(:sub_nav), class: 'ui-title-bar-accessory') : yield(:sub_nav)

      = tag.turbo_frame id: 'flash' do
        - if flash.present?
          = render Ui::Flash::Component.new(notice:, alert:)

      / A page with a fixed navigation fills the window, so the card and the
        footer keep their place between its tabs. On a phone, the navigation
        stays and main scrolls below it. On a computer, the window scrolls,
        so the scroll bar stays at its edge, and the card grows with its
        content. The scroll padding keeps a focused element off the edge, so
        the keyboard shows it with its ring and the rest of its row.
      main.relative.flex.flex-auto.min-h-0 class= [fixed_nav ? 'max-lg:overflow-y-auto scroll-pt-4 scroll-pb-20 lg:[html:has(&)]:scroll-pt-4 lg:[html:has(&)]:scroll-pb-20 max-lg:bg-white max-lg:dark:bg-slate-900 lg:-mt-32' : '-mt-32', ('lg:landscape:max-h-[700px]' if full_height), ('lg:landscape:flex-initial' unless fixed_nav || full_height)]
        .max-w-screen-xl.3xl:max-w-screen-2xl.mx-auto.lg:px-8.flex-auto.flex.min-h-0.min-w-0
          / On a phone, a page with `content_for :grouped` puts white cards on
            the gray of a grouped list, like the Top 10
          .bg-white.dark:bg-slate-900.text-gray-700.dark:text-slate-400.lg:rounded-lg.lg:shadow-sm.p-4.pb-3.sm:p-5.sm:px-6.flex-auto.flex.flex-col.min-w-0#inner class=[(fixed_nav ? 'max-lg:self-start max-lg:min-h-full' : 'lg:rounded-t-lg overflow-hidden min-h-0'), ('max-lg:bg-canvas' if content_for?(:grouped))]
            = yield

        / Shown while a page loads on a phone (see application.css)
        .ui-busy-spinner.hidden.fixed.inset-0.items-center.justify-center.pointer-events-none
          = render Ui::Loading::Component.new

        = render 'layouts/modal_backdrop'
        = tag.turbo_frame id: Ui::TurboModal::Component::FRAME, target: '_top'
        = render Ui::BottomSheet::Component.new(id: 'tooltip-sheet', data: { turbo_permanent: true })
        = render Ui::ConfirmDialog::Component.new

      = render Nav::Bottom::Component.new(items: all_mobile_items, more_current: more_current?, helios_dot: helios_dot?, unread_count: unread_notifications_count)

      footer.hidden.lg:landscape:flex.max-w-screen-xl.3xl:max-w-screen-2xl.mx-auto.justify-between.items-center.w-full.text-xs.py-3.px-4.sm:px-6.lg:px-8.dark:text-gray-400
        .flex.items-center.gap-2
          = link_to SolectrusLink.url('https://solectrus.de', campaign: 'footer'),
                    class: 'tracking-wider focus:outline-none focus:ring-2 focus:ring-gray-700 dark:focus:ring-gray-400 focus:ring-offset-0 rounded',
                    target: '_blank',
                    rel: 'noopener' do
            | SOLECTRUS.de
          = render VersionInfo::Component.new

        = render AuthorLogo::Component.new
