doctype html
html class= (params.dig(:lookbook, :display, :theme) == 'dark' ? 'dark' : nil)
  head
    title ViewComponent Preview
    meta name="viewport" content="width=device-width,initial-scale=1"

    = vite_typescript_tag 'application', 'data-turbo-track': 'reload'
    = vite_stylesheet_tag 'application.css', 'data-turbo-track': 'reload', media: 'screen'

  body.h-screen.bg-white.dark:bg-slate-900.text-gray-700.dark:text-slate-400
    / A bare preview fills the page without padding, like a page of the app.
    / With a max_width, the preview fills that width. Without one, it keeps
    / its own width. Both sit in the center. The heading of a grouped scenario
    / is an h6 that Lookbook resets with an inline "all: unset".
    ruby:
      max_width = params.dig(:lookbook, :display, :max_width)
      bare = params.dig(:lookbook, :display, :bare)
      centered = max_width ? 'mx-auto' : 'flex flex-col items-center [&>div>h6]:text-center!'
    div class=('p-5 h-full' unless bare)
      div[
        class= ['h-full', (centered unless bare)]
        style= ("max-width: #{max_width}" if max_width)
      ]
        = yield
