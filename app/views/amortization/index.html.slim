- turbo_exempts_page_from_cache
- content_for :full_height, true

- if !admin? && !Setting.amortization_public
  /! Admin decided the calculation is not public - hide it from other visitors
  .flex-1.min-h-0.flex.flex-col.justify-center.gap-6
    p.text-center.text-sm.md:text-base.text-gray-500.dark:text-gray-400
      = t('.restricted')
- elsif ApplicationPolicy.amortization?
  - if @missing_or_stale_summary_days.present?
    /! Measured savings incomplete - build the missing daily summaries first,
    /! then reload (same mechanism as Top10), so the calculation runs on
    /! complete data.
    .flex-1.min-h-0
      = render SummaryBuilder::Component.new(timeframe:, missing_or_stale_days: @missing_or_stale_summary_days)
  - elsif @result
    /! Cash flows present: show the calculation
    - if @result.prognosis?
      /! Layout on every form factor: the compact KPI rail sits on top, the
      /! balance curve fills the remaining height below it. The key figures also
      /! live as annotations on the curve (break-even, today's net position +
      /! degree, final balance). The parameter sliders sit in a drawer behind the
      /! round button in the chart's top-right controls. Wrapped in a Turbo frame
      /! so the sliders can auto-refresh it.
      = turbo_frame_tag 'amortization_detail', class: 'flex-1 min-h-0 flex flex-col gap-3' do
        /! Mobile-only page header (lg:hidden): sack icon + title + params drawer.
        /! Styled like the settings mobile header - a full-bleed indigo bar (the
        /! negative margins cancel #inner's padding to reach the card edges),
        /! white label, indigo icon. On desktop the params control stays inside
        /! the chart's top-right corner, so nothing changes there.
        .flex.items-center.justify-between.gap-3.lg:hidden.-mx-4.-mt-4.sm:-mx-6.sm:-mt-5.px-4.sm:px-6.py-3.bg-indigo-600.dark:bg-indigo-900
          .flex.items-center.gap-3.text-white.dark:text-gray-200
            i.fa.fa-sack-dollar.text-xl.text-indigo-200.dark:text-gray-400
            span.text-lg.font-medium = t('layout.amortization')

          div class='relative' data-controller='dropdown--component'
            button[
              type='button'
              class='flex items-center justify-center size-9 rounded-full text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/60 cursor-pointer'
              data-dropdown--component-target='button'
              data-action='click->dropdown--component#toggle'
              aria-haspopup='true'
              aria-expanded='false'
              aria-label=t('.parameters')
            ]
              i.fa.fa-sliders
            div[
              class='absolute top-full right-0 z-20 mt-2 hidden w-80 max-w-[calc(100vw-2rem)] rounded-lg bg-white dark:bg-gray-800 p-4 text-left shadow-lg ring-1 ring-black/5'
              data-dropdown--component-target='menu'
              data-transition-enter='transition ease-out duration-100'
              data-transition-enter-start='opacity-0 scale-95'
              data-transition-enter-end='opacity-100 scale-100'
              data-transition-leave='transition ease-in duration-75'
              data-transition-leave-start='opacity-100 scale-100'
              data-transition-leave-end='opacity-0 scale-95'
            ]
              = render AmortizationControls::Component.new(result: @result)

        /! KPI rail. Kept in the DOM even when hidden on very short viewports
        /! (sr-only, not display:none) so the figures stay available to screen
        /! readers and the specs.
        div class='tiny:sr-only'
          = render AmortizationStats::Component.new(result: @result)

        /! Chart fills the remaining height below the KPI rail, on every form factor
        .flex-1.min-h-0.flex.flex-col
          = render AmortizationChart::Component.new(result: @result)
    - else
      /! Not enough measured data yet - degree teaser shows the reason
      .flex-1.min-h-0.flex.flex-col.justify-center.gap-6
        = render AmortizationDegree::Component.new(result: @result)
  - else
    /! Cash flows missing: ask the admin to create them
    = render Message::Component.new do |c|
      - c.with_icon do
        i.fa.fa-sack-dollar
      = c.with_title { t('.no_cash_flows_title') }
      = c.with_body { t('.no_cash_flows_body') }
      - if admin?
        = c.with_footer do
          = render Button::Component.new title: t('.manage_cash_flows'),
                                         path: settings_cash_flows_path,
                                         style: :primary
- else
  /! Sponsor feature not available: promote it and link to the demo
  = render DemoLink::Component.new(feature: 'amortization')
