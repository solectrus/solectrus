- helios = HeliosCheck.available?
- if Rails.application.config.x.admin_password.present?
  = form_with model: @admin_user, url: sessions_path, id: dom_id(@admin_user) do |f|
    = hidden_field_tag :return_to, @return_to
    = f.group do
      .hidden
        = f.text_field :username, value: 'admin', autocomplete: 'username'
      = f.password_field :password,
                         hint: t(helios ? 'login.password_hint_helios' : 'login.password_hint').html_safe,
                         required: true,
                         autocomplete: 'current-password',
                         autofocus: true

    = f.actions do
      = render Button::Component.new path: @return_to,
                                     title: t('login.cancel'),
                                     style: :secondary
      = f.submit t('login.submit')
- else
  p.mt-5.text-red-500.dark:text-red-400
    = t('login.missing_password_error')
  p.mt-5.text-sm
    == t(helios ? 'login.missing_password_hint_helios' : 'login.missing_password_hint')
