/ A swipe turns the page to the period before or after, and the live view to
  yesterday or to the forecast (see swipe_controller.ts)
- extra_stimulus_controllers 'swipe' if timeframe.can_paginate? || timeframe.now?

- content_for :sub_nav do
  .flex.flex-col.gap-2.pb-2.lg:landscape:flex-row.lg:landscape:items-center.lg:landscape:justify-between.lg:landscape:gap-0.lg:landscape:py-5
    = tag.turbo_frame id: frame_id('second-nav'), target: '_top' do
      = render Nav::Sub::Component.new do |c|
        - c.with_items nav_items

    / The timeframe of a wide screen
    .hidden.lg:landscape:flex.items-center.justify-end
      - if timeframe.now?
        = tag.turbo_frame id: frame_id('status'),
                          data: { turbo_permanent: true },
                          class: 'flex items-center order-1'

      = tag.turbo_frame id: frame_id('timeframe'),
                        target: '_top',
                        data: { turbo_permanent: true },
                        class: 'h-8 space-x-4 flex flex-1 items-center justify-end' do
        = render Timeframe::Component.new(timeframe:)

      / A select of the page, the car for one, before the timeframe
      - if content_for?(:sub_nav_select)
        .empty:hidden.order-first.mr-4
          = yield :sub_nav_select

/ A phone has the period at the top of the content (see
  Timeframe::Pager::Component), and below it the choices of a select of the
  page as chips, the cars for one. The live view has its status in the place
  of the period (see TurboStreamHelper#turbo_stream_update_status).
= tag.div id: frame_id('pager'), class: 'lg:landscape:hidden' do
  = render Timeframe::Pager::Component.new(**pager_items)
- if timeframe.now?
  = tag.turbo_frame id: frame_id('status-content'),
                    data: { turbo_permanent: true },
                    class: [Timeframe::Pager::Component::ROW_CLASS, 'flex items-center justify-center lg:landscape:hidden']
- if content_for?(:sub_nav_chips)
  .mb-3.lg:landscape:hidden
    = yield :sub_nav_chips
