= turbo_stream.update frame_id('timeframe') do
  = render Timeframe::Component.new(timeframe:)

- if timeframe.now?
  = turbo_stream_update_status time: data.time,
                               max_age: Influx::PollInterval.tolerated_delay,
                               status: data.system_status,
                               status_ok: data.system_status_ok

= turbo_stream.update frame_id('stats'), method: :morph do
  - if timeframe.now?
    = render Balance::StatsNow::Component.new data:, sensor:
  - else
    = render Balance::StatsRange::Component.new data:, timeframe:, sensor:
