= render 'sub_nav'

- if @missing_or_stale_summary_days.present?
  = render SummaryBuilder::Component.new(timeframe:, missing_or_stale_days: @missing_or_stale_summary_days, charging_sessions: true)
- else
  / The list keeps the z-index of its sticky rows to itself. Otherwise they
    cover the lower half of the add button, which reaches down from the header.
    The top padding keeps the filter clear of that half.
  .isolate.flex.flex-col.flex-1.lg:landscape:pt-8
    = render ChargingSession::Filter::Component.new(kind:, timeframe:, cars:, current: car_param)
    = tag.turbo_frame id: 'list', class: 'flex flex-col flex-1 min-h-0' do
      = render ChargingSession::List::Component.new(charging_sessions: @charging_sessions, pagy: @pagy, kind:, timeframe:, filter: car_filter)
