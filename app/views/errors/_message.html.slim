= render Ui::Message::Component.new do |c|
  = c.with_title do
    = t("errors.#{status_code}.title")

  = c.with_body do
    == t("errors.#{status_code}.description")

  = c.with_footer do
    / Break out of the frame: this partial also renders inside the `modal`
    / frame, and neither target page contains that frame. Without `_top`
    / Turbo empties the frame, which closes the modal and goes nowhere.
    - if status_code == 403
      = render Ui::Button::Component.new href: new_session_path, \
                                     label: t('errors.login'), \
                                     data: { turbo_frame: '_top' }
    - else
      = render Ui::Button::Component.new href: balance_home_path, \
                                     label: t('errors.back_to_home'), \
                                     data: { turbo_frame: '_top' }
