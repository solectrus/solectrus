- turbo_exempts_page_from_cache
- content_for :full_height, true
- extra_stimulus_controllers 'swipe' if timeframe&.can_paginate?

- if @missing_or_stale_summary_days.present?
  = render 'shared/home_sub_nav'
  = turbo_stream.update frame_id('timeframe') do
    = render Timeframe::Component.new(timeframe:)
  = render SummaryBuilder::Component.new(timeframe:, missing_or_stale_days: @missing_or_stale_summary_days, charging_sessions: true)

- elsif Sensor::HomePage.permitted?(page_key)
  / The driving cost is the main number of the page, so its dependencies
  / (odometer and wallbox) decide whether the page has anything to show.
  - if Sensor::Config.exists?(:car_driving_costs)
    = render 'shared/home_sub_nav'
    = render StatsWithChart::Component.new(sensor_name:, timeframe:)
  - else
    = render Message::Component.new do |c|
      - c.with_watermark do
        = icon 'car'
      = c.with_title { t('layout.incomplete_car') }
      = c.with_body { raw t('layout.missing_car') }

- else
  = render DemoLink::Component.new feature: Sensor::HomePage.feature(page_key),
                                   url: { **permitted_params }
