= render 'sub_nav'

/ The place of the list as a chip that removes it. A phone has the select of
  the car beside it, as the charging sessions have it above their list. The
  desktop has the select in the header. They answer a tap themselves, so
  they stay lit while the next page loads (see application.css).
- phone_select = car_select? && @pending_days.blank?
- if place || phone_select
  .ui-keep-lit.mb-4.flex.items-center.gap-3 class=('lg:hidden' unless place)
    - if place
      .min-w-0.lg:mx-auto
        = render Place::VisitList::FilterChip::Component.new(remove_path: visits_path_with(place: nil)) do
          = icon 'location-dot', class: 'text-gray-500'
          span.truncate class=('italic text-gray-500' unless place.display_name)
            = place.display_name || t('settings.places.unnamed')
          = render Place::Labels::Component.new(place:)
    - if phone_select
      .ml-auto.lg:hidden
        = render Car::Select::Component.new(cars: located_cars, car:, path: ->(id) { visits_path_with(car: id) }, button_class: 'bg-white text-slate-700 dark:bg-slate-800 dark:text-slate-300')

= render Place::VisitsBuild::Component.new(timeframe: build_timeframe, pending_days: @pending_days) do
  = render Place::VisitList::Component.new(visits: @visits, pagy: @pagy, context: list_context)
