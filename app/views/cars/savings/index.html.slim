/ The head of the comparison, a page below the car page (see
  Car::SubNav::Component)
- content_for :fixed_nav, true
/ A swipe turns the page to the year before or after, as on the home pages
  (see swipe_controller.ts)
- extra_stimulus_controllers 'swipe' if timeframe.can_paginate?
- car_select_offered = car_select? && @pending_days.blank?
- content_for :sub_nav do
  = render Car::SubNav::Component.new(title:, back: { back_href: back_path, back_label: t('layout.car'), back_slide: false }, tabs: list_tabs, car_select: (car_select_component if car_select_offered)) do |nav|
    - nav.with_timeframe do
      = render Timeframe::Component.new(timeframe:, page: timeframe_page)

/ The period of a phone at the top of the content, and the cars as chips, as
  on the car page (see Timeframe::Pager::Component)
.lg:hidden
  = render Timeframe::Pager::Component.new(**pager_items)
  - if car_select_offered
    .mb-3
      = render car_select_component(chips: true)

- if @pending_days.present?
  = render Summary::Builder::Component.new(timeframe:, missing_or_stale_days: @pending_days)
- else
  / The comparison comes in a request of its own (see comparison.html.slim).
    A link in it leaves the frame and opens its page.
  = render Ui::LazyFrame::Component.new id: 'comparison', src: request.fullpath, target: '_top', class: 'flex flex-auto flex-col'
