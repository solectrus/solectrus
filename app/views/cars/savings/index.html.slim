- content = capture do
  - if @pending_days.present?
    = render Summary::Builder::Component.new(timeframe:, missing_or_stale_days: @pending_days)
  - else
    / The comparison comes in a request of its own (see comparison.html.slim).
      A link in it leaves the frame and opens its page, also from the sheet.
      A save in the modal, like the settings of a car, loads it again.
    = render Ui::LazyFrame::Component.new id: 'comparison', src: request.fullpath, target: '_top', class: 'flex flex-auto flex-col', data: { controller: 'frame-reload', action: 'ui--turbo-modal--component:changed@document->frame-reload#reload' }

/ In the sheet of a phone, over the car page, the comparison keeps the
  timeframe and the car of the car page (see SheetPage)
- if sheet_page?
  = render Ui::SheetPage::Component.new(title:, subtitle: timeframe.localized) do
    = content
- else
  = render 'sub_nav'
  = content
