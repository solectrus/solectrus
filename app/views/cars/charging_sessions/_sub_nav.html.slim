- content_for :fixed_nav, true
- content_for :sub_nav do
  / Phone: the title bar of a page below the car page, as in the settings. The
    plus adds a session on a page of its own. The car page has no title bar,
    so the way back to it does not slide.
  = render Ui::TitleBar::Component.new(title: t('charging_sessions.title'), back_href: back_path, back_label: t('layout.car'), back_slide: false) do |bar|
    - if ChargingSession::AddButton::Component.offered?(kind:, selection: car_selection)
      - bar.with_action(href: new_cars_charging_session_path(list_params), icon: 'plus', label: t('charging_sessions.new'))

  / On a phone the accessory of the title bar. It belongs to the list and
    leaves the bar when a session opens (see Ui::TitleBar::Component).
  .ui-title-bar-accessory.relative.flex.flex-col.pb-3.lg:flex-row.lg:items-center.lg:justify-between.lg:py-5
    / The desktop starts with the way back to the car page and the kinds as
      pill buttons. A phone has the title bar for the way back, and the kinds
      above the list (see the index).
    .hidden.lg:flex.items-center.gap-2
      = render Car::BackLink::Component.new(path: back_path)
      = render Nav::Sub::Component.new(abbreviate: false) do |c|
        - c.with_items nav_items

    / On the lower edge of the header, the ring parts it from the header
    = render ChargingSession::AddButton::Component.new(kind:, selection: car_selection, css_class: 'absolute top-full left-1/2 -translate-x-1/2 -translate-y-1/2 z-30 ring-2 ring-white dark:ring-slate-900')

    / The desktop has the filter before the timeframe. A phone has it above
      the list (see the index).
    .flex.items-center.lg:gap-4
      .w-full.min-w-0.flex.items-center.lg:h-8.lg:w-auto
        = render Timeframe::Component.new(timeframe:, page: timeframe_page)
      - if @missing_or_stale_summary_days.blank?
        .hidden.lg:block.empty:hidden.lg:order-first
          = render ChargingSession::Filter::Component.new(kind:, timeframe:, cars: car_selection.offered, current: car_selection.to_param)
