= form_page_with(model: [:cars, charging_session]) do |f|
  - if charging_session.wallbox?
    / The detection writes the energy, the time and the cost of a wallbox
    / session. The user decides who charged.
    = f.group do
      = render ChargingSession::Facts::Component.new(charging_session:)

      = f.select :car_id,
                 wallbox_holder_options(charging_session),
                 { selected: charging_session.holder, hint: holder_hint(charging_session) },
                 autofocus: true

      = f.text_area :note, rows: 3

  - else
    - if charging_session.proposal?
      / A save accepts the proposal of the build. Its dismissal stands beside
        the hint, but submits a form of its own (see the view edit), so Enter
        in a field still saves. The modal gives the hint its whole width.
      .mt-2.mb-4.p-4.text-sm.bg-amber-50.text-amber-700.dark:bg-amber-500/10.dark:text-amber-400.flex.items-center.gap-3 class=(form_in_modal? ? '-mx-6 px-6' : 'rounded-lg')
        p.flex-1 = t('charging_sessions.proposal.form_hint')
        button.shrink-0.flex.items-center.gap-2.whitespace-nowrap.cursor-pointer.text-signal-negative.lg:hover:underline.underline-offset-4.max-lg:active:opacity-60 type='submit' form=dom_id(charging_session, :dismiss)
          = icon 'xmark'
          = t('charging_sessions.proposal.dismiss')

    / Rows of four fields on a wide screen, so the form fits the height of a
      small laptop and leaves no gap: the car and the charging point, the time,
      the energy and the cost, then the address over its map. On a phone each
      group is a card of cells (see ui_form.css). Each group stands in a box of
      its own, so it is the last child and keeps no margin below it. The
      address-lookup controller checks a changed address at once, and it takes
      the point that the user moves on the map. Once the form opened, it asks
      Nominatim what the edit left to it (see Cars::ChargingSessionsController#edit).
    .grid.grid-cols-1.gap-8.lg:gap-4 data-controller='address-lookup' data-address-lookup-url-value=(charging_session.persisted? ? address_cars_charging_session_path(charging_session) : address_cars_charging_sessions_path) data-address-lookup-pending-value=('true' if local_assigns[:address_pending])
      div
        = f.group(flush: true) do
          .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-4.ui-form-contents
            = f.select :car_id, car_options(charging_session)
            = f.select :power_type,
                       ChargingSession.power_types.keys.map { |pt| [ChargingSession.human_enum_name(:power_type, pt), pt] },
                       include_blank: true
            = f.text_field :provider
            = f.text_field :evse_id

      div
        = f.group(flush: true) do
          .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-4.ui-form-contents
            = f.datetime_local_field :started_at, autofocus: true
            = f.datetime_local_field :ended_at
            = f.number_field :kwh,
                             in: 0..10_000,
                             step: '0.001',
                             suffix: 'kWh'
            = f.number_field :cost,
                             in: 0..10_000,
                             step: '0.01',
                             currency: true
          / Below the fields, so the facts of the charge fit on one line
          = render ChargingSession::SocFacts::Component.new(charging_session:, css_class: 'label-hint')

      div
        = f.group(flush: true) do
          = render('address', f:, charging_session:)

      = render('map', charging_session:)

      / The placeholder names the note, so it needs no label
      .ui-form-group
        = f.text_area :note, rows: 2, label: false

  = render Ui::SubmitButton::Component.new(**charging_session_removal(charging_session))
