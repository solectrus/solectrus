/ The form in the modal of the desktop, or on a page of its own on a phone,
  one level below the list (see Ui::FormPage::Component)
- heading = t(@charging_session.proposal? ? 'charging_sessions.proposal.title' : 'charging_sessions.edit')
- content_for :fixed_nav, true
- content_for :sub_nav do
  = render Ui::TitleBar::Component.new(title: heading, back_href: list_path, back_label: t('charging_sessions.title')) do |bar|
    - bar.with_save(form: form_page_id(@charging_session))

= render Ui::FormPage::Component.new(title: heading, width: (@charging_session.wallbox? ? :wide : :extra_wide)) do
  = render 'form', charging_session: @charging_session

  / The dismissal of a proposal, whose button stands in the hint of the form.
    Apart from the form, so it is not the default button of the form, and
    within the modal, which closes after a submit inside it.
  - if @charging_session.proposal?
    = form_with url: dismiss_cars_charging_session_path(@charging_session),
                method: :patch,
                id: dom_id(@charging_session, :dismiss),
                class: 'hidden',
                data: { **Ui::ConfirmDialog::Component.data(t('charging_sessions.proposal.confirm_dismiss'), button: t('confirm.dismiss'), destructive: true), **form_page_target } do
      = hidden_field_tag :return_to, return_to, id: nil if return_to
