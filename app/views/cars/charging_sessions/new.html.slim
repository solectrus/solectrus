/ The form in the modal of the desktop, or on a page of its own on a phone,
  one level below the list (see Ui::FormPage::Component)
- heading = t('charging_sessions.new')
- content_for :fixed_nav, true
- content_for :sub_nav do
  = render Ui::TitleBar::Component.new(title: heading, back_href: list_path, back_label: t('charging_sessions.title'))

= render Ui::FormPage::Component.new(title: heading, width: :extra_wide) do
  = render 'form', charging_session: @charging_session
