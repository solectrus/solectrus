- if request.get?
  = render TurboModal::Component.new(title: t(@charging_session.proposal? ? 'charging_sessions.proposal.title' : 'charging_sessions.edit'), width: (@charging_session.wallbox? ? :wide : :extra_wide)) do
    = render 'form', charging_session: @charging_session
- else
  = turbo_stream.replace(dom_id(@charging_session, :form), partial: 'form', locals: { charging_session: @charging_session })
