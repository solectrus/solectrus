/ The live view has no navigation streams, so it renders its timeframe
- if timeframe.now?
  = turbo_stream.update frame_id('timeframe') do
    = render Timeframe::Component.new(timeframe:)

  = turbo_stream_update_status time: data.time, max_age: Car::Live::MAX_AGE, live_expected: false

  = turbo_stream.update scoped_frame_id('stats'), method: :morph do
    .h-full.w-full.flex.flex-col id="stats-#{timeframe.id}"
      = render Car::LiveView::Component.new(live: data)

/ The figures of each column of the overview (see Car::Section), from one
  request and one report
- else
  - overview_sections.each do |section|
    = turbo_stream.update scoped_frame_id("stats-#{section}"), method: :morph do
      div id="stats-#{section}-#{timeframe.id}" class="lg:flex-1 lg:flex lg:flex-col"
        - if section == :driving
          = render Car::DrivingBox::Component.new(report: data)
        - else
          = render Car::ChargingBox::Component.new(report: data, all: car.nil? && !car_selection.guest?)

  / The navigation of a period. The live view refreshes often and keeps it.
  = render 'cars/navigation_streams'
