/ The live view has no navigation streams, so it renders its timeframe
- if timeframe.now?
  = turbo_stream.update scoped_frame_id('timeframe') do
    = render Timeframe::Component.new(timeframe:)

  = turbo_stream.update scoped_frame_id('stats'), method: :morph do
    .h-full.w-full.flex.flex-col id="stats-#{timeframe.id}"
      = render Car::LiveView::Component.new(live: data)

- else
  / The figures of the charging and of the driving, from one request and
    one report: the cards, or without an odometer the card of the charging
  = turbo_stream.update scoped_frame_id('stats'), method: :morph do
    div id="stats-overview-#{timeframe.id}" class='flex h-full w-full'
      = render Car::PeriodOverview::Component.new(report: data, all: car.nil? && !car_selection.guest?, driving: driving?)

  / The timeline of a day, beside the cards, refreshes with the figures
  - if day_timeline
    = turbo_stream.update scoped_frame_id('timeline'), method: :morph do
      = render Car::DayTimeline::Component.new(timeline: day_timeline, named: car_select? && car.nil? && !car_selection.guest?)

  / The navigation of a period. The live view refreshes often and keeps it.
  = render 'cars/navigation_streams'
