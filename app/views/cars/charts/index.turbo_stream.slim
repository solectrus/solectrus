= render 'cars/navigation_streams'

/ The chart of a column of the overview (see Car::Section). The phone shows
  one chart, so its menu has the charts of both columns.
= turbo_stream.update frame_id("chart-#{Car::Section.of(sensor_name)}") do
  div class='flex flex-col flex-auto min-h-20 max-lg:gap-1 sm:gap-2 relative'
    - unless timeframe.out_of_scope?
      .lg:hidden
        = render ChartDropdown::Car::Component.new(sensor_name:, timeframe:, all: true)
      .max-lg:hidden
        = render ChartDropdown::Car::Component.new(sensor_name:, timeframe:)
      div class='flex-1 min-h-0 flex flex-col relative'
        .flex-1.min-h-0.flex.flex-col.relative
          = render ChartLoader::Component.new(sensor_name:, timeframe: data_timeframe, interval:)
