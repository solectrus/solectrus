- if cash_flows.any?
  .table.w-full.select-text
    / Header cells stick to the viewport top while the list scrolls. Each cell
    / carries the page background so rows never show through the sticky row.
    .table-header-group.text-gray-800.dark:text-gray-400
      .table-row
        .table-cell.sticky.top-0.z-10.bg-white.dark:bg-slate-900.align-middle.p-2.tabular-nums.text-left.font-bold
          = CashFlow.human_attribute_name(:date)
        .hidden.sm:table-cell.sticky.top-0.z-10.bg-white.dark:bg-slate-900.align-middle.p-2.text-left.font-bold
          = CashFlow.human_attribute_name(:category)
        .table-cell.sticky.top-0.z-10.bg-white.dark:bg-slate-900.w-full.align-middle.p-2.text-left.font-bold
          span.hidden.md:inline = CashFlow.human_attribute_name(:note)
        .table-cell.sticky.top-0.z-10.bg-white.dark:bg-slate-900.align-middle.p-2.tabular-nums.text-right.font-bold
          = CashFlow.human_attribute_name(:amount)
        .table-cell.sticky.top-0.z-10.bg-white.dark:bg-slate-900

    .table-row-group.text-gray-800.dark:text-gray-400
      - cash_flows.each do |cash_flow|
        .table-row.group.hover:bg-gray-100.dark:hover:bg-gray-700
          .table-cell.align-middle.p-2.tabular-nums.text-left.w-1.whitespace-nowrap
            time datetime= cash_flow.date.iso8601
              = l cash_flow.date
          .hidden.sm:table-cell.align-middle.p-2.w-1.whitespace-nowrap
            .inline-flex.items-center.gap-1.5
              = render CashFlowCategoryPill::Component.new(category: cash_flow.category)
              - if filterable?(cash_flow)
                = link_to filter_path(cash_flow),
                          class: 'text-gray-400 dark:text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity',
                          data: { turbo_frame: '_top', controller: 'tooltip' },
                          title: t('.filter_by_category'),
                          'aria-label': t('.filter_by_category') do
                  = icon 'chevron-right', class: 'text-xs'
          .table-cell.w-full.align-middle.p-2.text-gray-500.text-sm
            span.hidden.md:inline = cash_flow.note
          .table-cell.align-middle.p-2.tabular-nums.text-right.w-1.whitespace-nowrap class=amount_color(cash_flow.amount)
            = formatted_amount(cash_flow.amount)

          / No right padding: the icon sits centered in a wider button, whose own
          / space already matches the inset of the date on the left.
          .table-cell.align-middle.w-1.py-2.pl-2
            = render Button::Component.new path: edit_settings_cash_flow_path(cash_flow),
                                           icon: 'pencil',
                                           type: :button,
                                           style: :secondary,
                                           options: { \
                                             method: :get,
                                             data: { turbo_frame: 'modal', controller: 'modal-launcher' },
                                             'aria-label': t('crud.edit'),
                                           }

    .table-footer-group.text-gray-800.dark:text-gray-200
      .table-row.border-t.border-gray-300.dark:border-gray-600
        .table-cell.align-middle.p-2.font-bold
          = t('.total')
        .hidden.sm:table-cell
        .table-cell.w-full
        .table-cell.align-middle.p-2.tabular-nums.text-right.font-bold.whitespace-nowrap class=amount_color(total)
          = formatted_amount(total)
        .table-cell
- else
  p.text-gray-500.p-2
    = t('.empty')
