h3.font-bold.text-base
  = t('.grid.header')

dl.mt-2.space-y-2
  .flex.items-center.justify-between.gap-4
    dt
      = t('.grid.import_power')
    dd.font-mono.text-right
      = render SensorValue::Component.new(data, :grid_import_power, context: :total, sign: :negative)

  .flex.items-center.justify-between.gap-4
    dt
      => "\u21D2"
      = t('.grid.import_costs')
    dd.font-mono.text-right
      = render SensorValue::Component.new(costs.parts.first, :grid_costs, sign: :negative, **costs.options)

h3.mt-5.font-bold.text-base
  = t('.pv.header')

dl.mt-2.space-y-2
  .flex.items-center.justify-between.gap-4
    dt
      = Sensor::Registry[:self_consumption].display_name(:short)
    dd.font-mono.text-right
      = render SensorValue::Component.new(data, :self_consumption, context: :total, sign: :negative)

  .flex.items-center.justify-between.gap-4
    dt
      => "\u21D2"
      = t('.pv.opportunity_costs')
    dd.font-mono.text-right
      = render SensorValue::Component.new(costs.parts.last, :opportunity_costs, sign: :negative, **costs.options)

dl.mt-5
  .flex.items-center.justify-between.gap-4
    dt.font-bold.text-base
      = t('.total_costs')
    dd.font-mono.text-right
      = render SensorValue::Component.new(costs.sum, :total_costs, sign: :negative, **costs.options)
