time.lg:landscape:ml-4.flex.items-center.gap-2.text-sm.lg:landscape:text-base.cursor-default.truncate[
  data-controller= (message.present? ? 'tooltip' : nil)
  data-tooltip-touch-value= ('true' if message.present?)
  datetime= time&.iso8601
  class= outer_class
]
  span.flex.size-2.shrink-0
    span.inline-flex.rounded-full.size-2 class= dot_class
  span.whitespace-nowrap.truncate
    = text

  - if message.present?
    span.hidden data-tooltip-target= 'html'
      .tooltip-layout
        = render TooltipHeader::Component.new(title: text) do
          .tooltip-detail = message
