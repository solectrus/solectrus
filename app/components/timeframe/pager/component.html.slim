/ The live view keeps its arrows hidden, for the swipe alone
nav[
  class=(period ? [ROW_CLASS, 'grid grid-cols-[auto_minmax(0,1fr)_auto] items-center text-muted'] : 'hidden')
  aria-label=t('.label')
  aria-hidden=('true' unless period)
]
  = arrow(:prev)

  / The chevron says that a tap opens the choice of periods
  - if period
    = link_to select_href, class: 'flex min-w-0 items-center justify-center gap-1.5 h-11 px-2 rounded-md text-base font-semibold text-fg click-animation', 'aria-haspopup': 'dialog', data: Ui::TurboModal::Component.link_data do
      span.truncate = period[:name]
      = icon 'chevron-down', class: 'shrink-0 text-xs text-faint'

  = arrow(:next)
