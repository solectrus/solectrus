.flex-auto.max-w-full.grid.items-center.gap-2.md:gap-4.text-gray-300.dark:text-gray-400.tracking-wider.whitespace-nowrap.text-sm.md:text-base class=(can_navigate? ? 'grid-cols-[1fr_auto_1fr]' : 'grid-cols-1')
  - if can_navigate?
    div
      - if can_navigate_backward?
        = link_to prev_path, class: paginate_button_classes, 'aria-label': t('.previous'), data: { nav: 'prev' } do
          = icon 'chevron-left', class: 'fa-lg'
      - else
        .lg:landscape:px-2.py-1
          = icon 'chevron-left', class: 'fa-lg opacity-50'

  - if forecast_mode?
    div class= timeframe_link_classes('text-center')
      = t('forecast.next_days', count: forecast_days)

  - else
    - case timeframe.id

    - when :all
      = link_to timeframe_select_path, class: timeframe_link_classes('text-center'), data: { turbo_frame: 'modal', controller: 'tooltip modal-launcher' }, title: t('.select_hint') do
        == timeframe.localized

    - when :day, :hours, :days, :range, :week, :month, :months, :year, :years
      = link_to timeframe_select_path, class: timeframe_link_classes(label_classes), data: { turbo_frame: 'modal', controller: 'tooltip modal-launcher' }, title: t('.select_hint') do
        time datetime= timeframe.iso8601
          = timeframe.localized

  - if can_navigate?
    .justify-self-end
      - if can_navigate_forward?
        = link_to next_path, class: paginate_button_classes, 'aria-label': t('.next'), data: { nav: 'next' } do
          = icon 'chevron-right', class: 'fa-lg'
      - else
        .lg:landscape:px-2.py-1
          = icon 'chevron-right', class: 'fa-lg opacity-50'
