- if sessions.empty?
  = render EmptyList::Component.new(icon: 'charging-station', text: t("charging_sessions.description.#{empty_key}"))
    p.text-gray-900.bg-gray-200.dark:bg-gray-700.dark:text-gray-400.px-2.py-1.rounded
      = t "charging_sessions.empty.#{empty_key}"
- else
  / The desktop has a table with the totals in a sticky row at the bottom. A
    phone has two cards in the style of iOS: the totals above, the sessions
    below. There the energy stands over the cost, as in the rows. One container for both, so the pages of the list load once.
  .grid.w-full.select-text.max-lg:flex.max-lg:flex-col.max-lg:gap-6 class=grid_columns
    .lg:contents.max-lg:overflow-hidden.max-lg:rounded-xl.max-lg:bg-white.dark:max-lg:bg-slate-800/60
      = render ChargingSession::Rows::Component.new(sessions:, pagy:)

    / One session would only repeat its row
    - if totals?
      .col-span-full.grid.grid-cols-subgrid.items-center.font-bold.text-gray-800.dark:text-gray-400.lg:sticky.lg:bottom-0.lg:z-10.lg:border-t.lg:border-current.lg:bg-white.lg:dark:bg-slate-900.max-lg:order-first.max-lg:gap-x-3.max-lg:rounded-xl.max-lg:bg-white.max-lg:px-4.max-lg:py-3.max-lg:font-semibold.dark:max-lg:bg-slate-800/60.dark:max-lg:text-slate-300 class="max-lg:grid-cols-[minmax(0,1fr)_auto] max-lg:grid-rows-[auto_auto]"
        .col-start-1.col-span-3.min-w-0.truncate.text-left.lg:p-2.lg:pt-4.max-lg:col-span-1.max-lg:row-span-2
          = totals.count
          span.font-light<
            = t('charging_sessions.count', count: totals.count)
        .tabular-nums.text-right.whitespace-nowrap.lg:p-2.lg:pt-4.max-lg:col-start-2.max-lg:row-start-1 class=(pv_share? ? 'col-start-4' : 'col-start-5')
          = render SensorValue::Component.new(totals.kwh * 1000, :wallbox_power, context: :total, scaling: :kilo)
        - if pv_share? && totals.pv_percent
          .col-start-5.hidden.lg:block.p-2.px-8.pt-4.tabular-nums.whitespace-nowrap
            = render ChargingSession::PvShareBar::Component.new(percent: totals.pv_percent)
        .col-start-6.tabular-nums.text-right.whitespace-nowrap.lg:p-2.lg:pt-4.max-lg:col-start-2.max-lg:row-start-2
          - if cost_incomplete?
            span.text-gray-400 title=t('charging_sessions.cost_incomplete') ≥
          = number_to_currency(totals.cost, unit: Currency.symbol)
