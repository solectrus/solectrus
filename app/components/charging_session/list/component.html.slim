= render Car::ListBox::Component.new(label: t('charging_sessions.title'), segments: kinds, totals: totals_text, totals_note:, stats:, map_path:, map_label:, map_button: !sheet) do |box|
  / The sessions to review beside the sums: an amber link with their number
    shows them alone, and then an amber button with an x shows each session
    again. Both have the same height, so the head keeps its layout.
  - if review
    - box.with_switch do
      = link_to review.href, role: 'switch', aria: { checked: review.on }, class: [REVIEW_CLASS, review.on ? REVIEW_ON_CLASS : REVIEW_OFF_CLASS] do
        span = review_label
        - if review.on
          = icon 'xmark', class: 'text-xs'

  - if admin_only_note?
    - box.with_banner do
      = render Car::AdminOnlyNotice::Component.new(text: t('.admin_only_days'), banner: true)

  / The sessions to review alone say what to do with them. Their proposals
    go at once, for a time without receipts. The time of the list keeps a
    proposal of a later build, which the admin did not see.
  - if review_only? && sessions.any?
    - box.with_note do
      .flex.items-center.justify-between.gap-4.text-sm.max-lg:flex-col.max-lg:items-start.max-lg:gap-2
        p.text-fg-secondary = t(".review_hint.#{kind}")
        - if dismiss_all?
          = button_to helpers.dismiss_cars_charging_sessions_path,
                      method: :patch,
                      params: { return_to: helpers.list_address, listed_at: Time.current.iso8601(6) },
                      form: { data: { turbo_frame: 'list', **Ui::ConfirmDialog::Component.data(t('charging_sessions.proposal.confirm_dismiss_all', count: review.number), button: t('confirm.dismiss_all'), destructive: true) } },
                      class: 'shrink-0 flex items-center gap-2 whitespace-nowrap cursor-pointer text-signal-negative lg:hover:underline underline-offset-4 max-lg:active:opacity-60' do
            = icon 'xmark'
            = t('charging_sessions.proposal.dismiss_all')

  - if sessions.empty? && review_only?
    = render Ui::EmptyState::Component.new(icon: 'check', title: t(".reviewed.#{kind}"))
  - elsif sessions.empty?
    = render Ui::EmptyState::Component.new(icon: 'charging-station', title: empty_title, text: empty_text)
  - else
    .grid.w-full.lg:select-text.lg:px-3.lg:pb-2 class=GRID_COLUMNS
      .lg:contents.max-lg:overflow-hidden.max-lg:rounded-xl.max-lg:bg-surface
        = render ChargingSession::Rows::Component.new(sessions:, pagy:, timeframe:)
