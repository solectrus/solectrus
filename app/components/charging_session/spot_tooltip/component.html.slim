div
  / The first line names the spot, the street of an address follows below
  - first_line, *other_lines = name_lines
  .font-semibold.line-clamp-2 = first_line
  - other_lines.each do |line|
    div = line

  / The line breaks only between the facts, not inside "3 sessions"
  .text-slate-500.dark:text-slate-400
    = safe_join(facts.map { tag.span(it, class: 'whitespace-nowrap') }, ' · ')

  - if cars.any?
    .mt-2.pt-2.flex.flex-col.gap-1.border-t.border-slate-200.text-slate-500.dark:border-slate-700.dark:text-slate-400
      - cars.each do |car|
        span.flex.items-center.gap-2
          span class='size-2.5 shrink-0 rounded-full ring-1 ring-black/10 dark:ring-white/20' style="background-color: #{car.display_color}"
          = car.display_name
