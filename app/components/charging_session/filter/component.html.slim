- if select?
  / The button of a phone beside the segments above the list, as the select
    of the car page: the native select with the short name of a car. The
    menu of the desktop stays hidden, its links serve the select.
  = render Ui::Dropdown::Component.new name: 'car',
                                       items:,
                                       selected: current.to_s,
                                       label: t('.label'),
                                       mobile_shape: Ui::Dropdown::Component::PILL_SHAPE,
                                       button_class: Ui::Dropdown::Component::PILL_BUTTON_CLASS
- else
  / The menu of the desktop, on the colored bar of the page header
  = render Ui::Dropdown::Component.new name: 'car',
                                       items:,
                                       selected: current.to_s,
                                       mobile: false,
                                       button_class: Ui::Dropdown::Component::HEADER_BUTTON_CLASS
