/ A row of the table from lg up. Below, the same cells form a cell of a
  grouped list in three lines, the values at the right: the day, the
  car and the energy, then the time and the cost, then the place or the PV
  share over the full width.
= render Ui::TableRow::Component.new(href: edit_path, nav_title:, css_class: 'grid items-center lg:col-span-full lg:grid-cols-subgrid max-lg:grid-cols-[auto_minmax(0,1fr)_auto_auto] max-lg:grid-rows-[auto_auto_auto] max-lg:gap-y-0.5') do |row|
  / The day is a target of its own on the desktop, with its own hover. The
    row does not light up over it, and the day stays out of the hover of the
    row. The time belongs to the row. On a phone a tap opens the session.
  .col-start-1.flex.items-center.min-w-0.tabular-nums.text-left.whitespace-nowrap.max-lg:contents
    = link_to day_path, class: 'max-lg:pointer-events-none max-lg:col-start-1 max-lg:row-start-1 max-lg:text-headline max-lg:text-gray-800 dark:max-lg:text-slate-300 lg:p-2 rounded-sm lg:bg-white lg:dark:bg-slate-900 lg:hover:underline underline-offset-4' do
      time datetime= charging_session.started_at.iso8601
        / On a phone, the short year leaves room for the time
        span.lg:hidden = charging_session.started_at.in_time_zone.strftime('%d.%m.%y')
        span.hidden.lg:inline = charging_session.started_at.in_time_zone.strftime('%d.%m.%Y')
    span.truncate.lg:py-2.lg:pr-2.max-lg:col-span-2.max-lg:col-start-1.max-lg:row-start-2.max-lg:text-subhead.max-lg:text-muted
      = time_range
  .col-start-2.min-w-0.flex.items-center.gap-2.lg:p-2.max-lg:row-start-1
    = row.link css_class: 'min-w-0' do
      = render Car::Badge::Component.new(charging_session:, short: true)
    - if charging_session.ongoing?
      = tag.span class: 'relative flex size-2 shrink-0',
                 role: 'img',
                 title: t('charging_sessions.ongoing'),
                 aria: { label: t('charging_sessions.ongoing') },
                 data: { controller: 'tooltip' } do
        span.absolute.inline-flex.size-full.rounded-full.bg-signal-positive.opacity-75.animate-ping.motion-reduce:animate-none
        span.relative.inline-flex.size-2.rounded-full.bg-signal-positive
    - if charging_session.proposal?
      = tag.span class: 'shrink-0 text-amber-500 dark:text-amber-400',
                 title: t('charging_sessions.proposal.hint'),
                 aria: { label: t('charging_sessions.proposal.hint') },
                 data: { controller: 'tooltip' } do
        = icon 'circle-question'
  / The state of charge has a column of its own, so it lines up in each row
  - if soc_range
    .col-start-3.hidden.lg:block.p-2.text-sm.text-gray-500.dark:text-gray-400.tabular-nums.whitespace-nowrap
      = soc_range
  / Grid items must follow the order of their columns: the PV share takes
    the wide column after the energy, the address the one before it
  - if pv_share?
    .col-start-4.tabular-nums.text-right.whitespace-nowrap.lg:p-2.max-lg:col-start-3.max-lg:row-start-1.max-lg:text-headline.max-lg:text-gray-800.dark:max-lg:text-slate-300
      = render Sensor::Value::Component.new(charging_session.kwh * 1000, :wallbox_power, context: :total, scaling: :kilo)
    .col-start-5.tabular-nums.whitespace-nowrap.lg:p-2.lg:px-8.max-lg:col-span-3.max-lg:col-start-1.max-lg:row-start-3.max-lg:mt-1.max-lg:text-subhead.max-lg:text-muted
      - if charging_session.pv_percent
        / A phone shows the bar alone, the energy and the cost are enough numbers
        = render ChargingSession::PvShareBar::Component.new(percent: charging_session.pv_percent, percent_class: 'max-lg:hidden')
      - else
        span.text-gray-400 –
  - else
    .col-start-4.min-w-0.truncate.text-sm.text-gray-500.lg:p-2.max-lg:col-span-3.max-lg:col-start-1.max-lg:row-start-3.max-lg:text-subhead.max-lg:text-muted.max-lg:empty:hidden
      = location
    .col-start-5.tabular-nums.text-right.whitespace-nowrap.lg:p-2.max-lg:col-start-3.max-lg:row-start-1.max-lg:text-headline.max-lg:text-gray-800.dark:max-lg:text-slate-300
      - if charging_session.kwh
        - if charging_session.proposal?
          span.text-gray-400 title=t('charging_sessions.proposal.estimate') ≈&nbsp;
        = render Sensor::Value::Component.new(charging_session.kwh * 1000, :wallbox_power, context: :total, scaling: :kilo)
      - else
        span.text-gray-400 title=t('charging_sessions.proposal.no_estimate') –
  .col-start-6.tabular-nums.text-right.whitespace-nowrap.lg:p-2.max-lg:col-start-3.max-lg:row-start-2.max-lg:text-subhead.max-lg:text-muted
    - if charging_session.cost
      = number_to_currency(charging_session.cost, unit: Currency.symbol)
    - else
      span.text-gray-400 title=t('charging_sessions.no_cost') –
