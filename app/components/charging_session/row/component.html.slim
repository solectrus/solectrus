/ A row of the table from lg up: the day, the time, the car, the energy, the
  state of charge, the place and the cost. A wallbox session shows its PV share as a bar in place
  of the place. Below lg the same cells form a cell of a grouped list in two
  lines: the day, then the car and the place, with the energy and the cost at
  the right. A wallbox session starts with a ring of its PV share there.
= render Ui::TableRow::Component.new(href: edit_path, nav_title:, css_class: ['grid items-center lg:col-span-full lg:grid-cols-subgrid max-lg:grid-rows-[auto_auto] max-lg:gap-y-0.5', phone_columns[:grid]]) do |row|
  - if charging_session.wallbox?
    .lg:hidden.row-span-2
      = render ChargingSession::PvRing::Component.new(percent: pv_percent)

  / The day is a target of its own on the desktop, with its own hover. On a
    phone a tap opens the session, so the day is plain text there.
  div class=['min-w-0 flex items-center gap-2 whitespace-nowrap lg:p-2 max-lg:row-start-1', phone_columns[:text]]
    = link_to day_path, class: 'max-lg:pointer-events-none shrink-0 rounded-sm text-fg lg:hover:underline underline-offset-4 focus-ring-inset' do
      time datetime=charging_session.started_at.iso8601
        = date
    / A phone has the start alone beside the day
    span.lg:hidden.truncate.text-muted.tabular-nums = "· #{start_time}"
    - if charging_session.ongoing?
      span.lg:hidden.flex = ongoing_dot

  / The desktop has the time in a column of its own, so the times of the
    rows stand one below the other
  .max-lg:hidden.flex.items-center.gap-2.whitespace-nowrap.p-2.text-muted.tabular-nums
    = time_range
    = ongoing_dot if charging_session.ongoing?

  / The car comes before the place on the desktop
  .hidden.lg:block.min-w-0.p-2
    = render Car::Badge::Component.new(charging_session:, short: true)

  / The energy stands left of the place or the bar of the PV share on the
    desktop
  div class=['tabular-nums text-right whitespace-nowrap font-semibold text-fg lg:p-2 max-lg:row-start-1 max-lg:text-headline', phone_columns[:value]]
    - if charging_session.kwh
      - if charging_session.proposal?
        span.text-faint title=t('charging_sessions.proposal.estimate') ≈&nbsp;
      = render energy
    - else
      span.text-faint title=t('charging_sessions.proposal.no_estimate') –

  / The state of charge before and after the session, on the desktop alone.
    A state of charge that contradicts the energy is dimmed and explained. A
    session without it leaves its cell empty, so a list without it has no gap.
  div class=['hidden lg:flex items-center text-sm tabular-nums whitespace-nowrap', ('p-2' if soc_range), soc_mismatch? ? 'text-faint' : 'text-muted']
    - if soc_range
      = soc_range
      - if soc_mismatch?
        = render Ui::InfoIcon::Component.new(text: soc_mismatch_hint, position: 'relative ml-1')

  / The place and the car. A phone has them in one line below the day. Each
    wallbox session charged at home, so the place is for a screen reader
    alone there. It stays the text of the link to the session, and the
    desktop has the bar of the PV share beside it.
  div class=['min-w-0 flex items-center gap-1.5 lg:p-2 max-lg:row-start-2 max-lg:text-subhead max-lg:text-muted', phone_columns[:text]]
    / A proposal has the question mark of the sessions to review in place of
      the place, which stays the text of the link for a screen reader
    = row.link css_class: ['truncate lg:text-fg-secondary', ('sr-only' if charging_session.wallbox? || charging_session.proposal?)] do
      = charging_session.proposal? ? t('charging_sessions.proposal.name') : place
    - if charging_session.proposal?
      = render ChargingSession::ReviewBadge::Component.new(label: t('charging_sessions.proposal.name'))
    - if pv_percent
      .max-lg:hidden.flex-1.min-w-0.pr-6.text-fg-secondary.tabular-nums.whitespace-nowrap
        = render ChargingSession::PvShareBar::Component.new(percent: pv_percent)
    - unless charging_session.wallbox? || charging_session.proposal?
      span.lg:hidden.shrink-0 aria-hidden='true' ·
    span.lg:hidden.shrink-0
      = charging_session.car ? charging_session.car.short_name : render(Car::Badge::Component.new(charging_session:, short: true))

  div class=['tabular-nums text-right whitespace-nowrap text-fg-secondary lg:p-2 max-lg:row-start-2 max-lg:text-subhead max-lg:text-muted', phone_columns[:value]]
    / A proposal never has a cost, so only a session without a price has a
      dash
    - if cost
      = cost
    - elsif !charging_session.proposal?
      span.text-faint title=t('charging_sessions.no_cost') –
