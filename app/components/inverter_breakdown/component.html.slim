.flex-1.min-h-0.flex.gap-5 *wrapper_attributes
  // Clip
  .flex.gap-10.items-end.px-3.md:px-5.py-2.md:py-3.xl:py-4
    .w-5.border-b-2.border-t-2.border-slate-500.h-full.flex.justify-center
      .flex.h-full.flex-col.items-center.justify-center.text-sm.md:text-lg.-ml-5.text-slate-500.dark:text-slate-400
        .w-0.flex-1.border-l-2.border-slate-500.mb-2

        = link_to inverter_home_path(sensor_name: 'inverter_power', timeframe:),
                  class: 'bg-white dark:bg-slate-900 pb-2 md:pb-4 pl-3',
                  title: Sensor::Registry[:inverter_power].display_name,
                  data: { \
                    controller: 'tooltip',
                    tooltip_placement_value: 'right',
                    tooltip_force_tap_to_close_value: false,
                    tooltip_touch_value: 'long',
                    turbo_prefetch: 'false',
                    action: 'stats-with-chart--component#loadChart',
                    stats_with_chart__component_sensor_name_param: 'inverter_power',
                    stats_with_chart__component_chart_url_param: inverter_charts_path(sensor_name: 'inverter_power', timeframe:),
                  } do
          div data= { 'stats-with-chart--component-target': sensor_name == :inverter_power ? 'current' : nil, 'sensor-name': sensor_name, value: data.inverter_power, time: data.time.to_i }
            = render SensorValue::Component.new(data, :inverter_power, context: timeframe.now? ? :rate : :total)

          #tooltip-content-inverter_power.hidden data-tooltip-target= 'html'
            .flex.flex-col.items-center.justify-center.gap-2.p-2
              i.fa.fa-2xl.fa-sun
              = Sensor::Registry[:inverter_power].display_name
              = render SensorValue::Component.new(data, :inverter_power, context: timeframe.now? ? :rate : :total, precision: 3)

        - if breakdown?
          button.mt-0.mb-3.flex.items-center.justify-center.size-8.rounded-full.border.border-gray-300.dark:border-gray-600.bg-gray-100.dark:bg-gray-800.hover:bg-gray-200.dark:hover:bg-gray-700.text-slate-500.dark:text-slate-400.cursor-pointer.transition-colors[
            data-controller="tooltip"
            data-tooltip-placement-value="right"
            data-tooltip-force-tap-to-close-value="false"
            data-tooltip-touch-value="long"
            data-action="view-toggle#toggle"
            aria-label=t('.toggle_view')
          ]
            span.hidden data-tooltip-target="html"
              = t('.toggle_view')
            i.fas.fa-table-list data-view-toggle-target="icon"
            i.fas.fa-chart-bar.hidden data-view-toggle-target="icon"

        .w-0.flex-1.border-l-2.border-slate-500

  // Inner content
  .flex-1.flex.flex-col.min-h-0
    .flex-1.flex data-view-toggle-target=('segments' if breakdown?)
      = render SegmentContainer::Component.new tooltip_placement: 'bottom',
                                               data:,
                                               timeframe: do |balance|
        - if no_production?
          - balance.with_segment :inverter_power,
                                 percent: 100,
                                 tooltip: false,
                                 color_class: 'bg-slate-600 dark:bg-slate-600/70' do
            p.text-xl
              = t('data.inverter_no_production')
        - else
          - custom_inverter_sensors.reverse_each.with_index(0) do |sensor, index|
            - balance.with_segment sensor.name,
                                   inline: true,
                                   color_index: sensor_count - index

          - balance.with_segment :inverter_power_difference,
                                 inline: true

    - if breakdown?
      .flex-1.min-h-0.hidden.overflow-hidden data-view-toggle-target="table"
        .w-full.h-full.flex.flex-col.min-h-0.bg-slate-200.dark:bg-slate-800.rounded-lg.p-2.md:p-3.xl:p-4
          .flex-1.flex.flex-col.overflow-y-auto.text-xl.md:text-2xl
            - table_rows.each do |row|
              = render InverterBreakdown::TableRow::Component.new(sensor: row[:sensor], percent: row[:percent], data:, timeframe:, scaling: common_scaling)

            - if show_other?
              = render InverterBreakdown::TableRow::Component.new(sensor: other_sensor, percent: other_percent, data:, timeframe:, scaling: common_scaling)
