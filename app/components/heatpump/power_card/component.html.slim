= link_to link_url,
          class: link_classes,
          data: link_data do
  - if show_ratio_bar?
    .text-center.text-sm
      = t('splitter.pv_percent', percent: power_pv_ratio.round)
      .w-full.flex.gap-px.rounded.overflow-hidden.mt-1
        - if power_pv_ratio.positive?
          .h-3.bg-sensor-pv[
            style= "width: #{power_pv_ratio}%;"
          ]
        - if grid_ratio.positive?
          .h-3.bg-sensor-grid[
            style= "width: #{grid_ratio}%;"
          ]
  - if timeframe.now?
    = render RectBadge::Component.new(title: t('sensors.heatpump_power_short')) do
      = render SensorValue::Component.new(data, :heatpump_power, context: :rate)
  - else
    .text-center class=("#{'mt-3' if grid_ratio}")
      = render SensorValue::Component.new(data, :heatpump_power, context: :total, class: 'text-2xl md:text-3xl')
  - if show_tooltip?
    #tooltip-content-heatpump_power.hidden data-tooltip-target= 'html'
      .tooltip-layout.tooltip-layout-table
        .tooltip-group
          - tooltip_rows.zip(tooltip_values.parts).each_with_index do |(row, value), index|
            = render TooltipRow::Component.new(label: row[:label], color_class: row[:bg], operator: index.zero? ? '' : '+') do
              = render SensorValue::Component.new(value, row[:sensor], **tooltip_values.options)

          .label-value-row.tooltip-result.tooltip-total
            strong
              |&#61;&nbsp;
              = t('splitter.total')
            = render SensorValue::Component.new(tooltip_values.sum, :heatpump_power, **tooltip_values.options)
