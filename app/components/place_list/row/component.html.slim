.col-span-full.grid.grid-cols-subgrid.items-center.hover:bg-gray-100.dark:hover:bg-gray-700 id=dom_id(place)
  .p-2.min-w-0
    .flex.items-center.gap-2.min-w-0
      .truncate class=('italic text-gray-500' unless place.display_name)
        = name
      = render PlaceLabels::Component.new(place:)
    .text-xs.text-gray-500.truncate.tabular-nums = details
  .p-2.text-sm.tabular-nums.whitespace-nowrap
    / The time links to the visits that make it up
    - if duration
      = link_to duration,
                helpers.cars_visits_path(place: place.id),
                class: 'hover:underline underline-offset-4',
                data: { turbo_frame: '_top' }
  .p-2
    = render Button::Component.new path: edit_path,
                                   icon: 'pencil',
                                   type: :button,
                                   style: :secondary,
                                   options: { \
                                     method: :get,
                                     data: { turbo_frame: 'modal', controller: 'modal-launcher' },
                                     'aria-label': t('crud.edit'),
                                   }
