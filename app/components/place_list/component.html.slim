- if places.empty?
  = render EmptyList::Component.new(icon: 'location-dot', text: t('settings.places.empty'))
- else
  .grid.w-full.max-lg:block.max-lg:overflow-hidden.max-lg:rounded-xl.max-lg:bg-white.dark:max-lg:bg-slate-800/60 class="grid-cols-[1fr_auto]"
    .col-span-full.grid.grid-cols-subgrid.text-gray-800.dark:text-gray-400.font-bold.max-lg:hidden
      .p-2 = Place.human_attribute_name(:name)
      .p-2 = t('settings.places.time')
    = render PlaceList::Rows::Component.new(places:, pagy:)

  p.px-4.pt-2.text-sm.text-muted.lg:px-2
    = t('settings.places.description')
