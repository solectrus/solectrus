/ The bar stays at the lower edge of the screen. A page that is longer than
  the screen scrolls below it, like the Top 10 on a small phone. The
  overlays of the page lie above it.
.sticky.bottom-0.z-30.lg:landscape:hidden
  / The pill of the current item moves to the tapped one right away, so the
    bar answers the touch instead of the page it loads. optimistic-nav swaps
    the two class lists, so the pill keeps its looks here in the template.
  nav.w-full.flex.items-center.justify-evenly.bg-indigo-600.dark:bg-indigo-900.border-t.border-indigo-300/25.dark:border-indigo-950/25[
    aria-label="Main navigation"
    class="pb-[calc(0.75rem+env(safe-area-inset-bottom))]"
    data-controller="optimistic-nav"
    data-action="turbo:click->optimistic-nav#markCurrent turbo:fetch-request-error@document->optimistic-nav#restore turbo:load@document->optimistic-nav#settle"
  ]
    - bar_items.each_with_index do |item, index|
      = link_to item[:href],
                class: tab_classes(active: item[:current]),
                'aria-current': (item[:current] ? 'page' : nil),
                'aria-label': item[:name] do
        span data-nav-state="" class=pill_classes(active: item[:current])
          - if index.zero?
            svg.size-5.fill-current viewBox="0 0 1200 1200"
              path d="m747.775 44.2c245.861 65.31 427.225 289.542 427.225 555.8 0 314.622-253.236 570.56-566.779 574.94 41.679-83.59 94.576-189.745 151.182-303.438 149.04-299.567 230.764-466.538 231.549-473.168 1.31-9.085.524-11.05-8.905-20.381-17.026-17.188-11.002-17.924-205.095 26.765-94.296 21.854-173.662 40.27-176.019 41.006-2.881.737-4.715 0-4.715-1.964 0-1.719 34.313-89.87 75.961-195.946 41.909-105.831 75.961-195.946 75.961-199.63 0-1.331-.124-2.661-.365-3.984zm-367.512 24.346c-39.478 141.435-171.707 647.798-171.707 660.539 0 16.943 17.026 31.921 36.147 31.921 4.191 0 88.272-18.907 186.497-41.743 98.487-23.081 179.686-41.497 180.734-41.252 1.048.491-37.456 151.503-85.39 335.909-14.918 57.08-27.922 107.14-38.984 150.07-263.581-52.32-462.56-285.102-462.56-563.99 0-239.537 146.788-445.06 355.263-531.454z"
          - else
            = icon item[:icon], class: 'fa-fw fa-lg'
        span.leading-tight.truncate class="text-[0.65rem]"
          = item[:name]

    = link_to helpers.more_path,
              class: tab_classes(active: more_current?),
              'aria-current': (more_current? ? 'page' : nil),
              'aria-label': t('.more') do
      span data-nav-state="" class=pill_classes(active: more_current?)
        / The dot hangs on the icon, not on the pill around it, so it sits at
        / the corner of the bars. Its ring carries the navigation background and
        / cuts it free from the bar it overlaps.
        / The amber dot for HELIOS lies in front of the red one. With both, the
        / red dot moves to the right and peeks out behind the amber one,
        / whose ring cuts it off. The ring is thinner then, so more of the red
        / dot shows. :has() follows the red dot, so the ring grows again when a
        / Turbo Stream removes the red dot.
        span.relative.flex class="group/dots"
          = icon 'bars', class: 'fa-fw fa-lg'
          span#bottom-nav-notification-dot.absolute.-top-1[
            class=(helios_dot? ? '-right-2.5' : '-right-1')
          ]
            = render Notification::Dot::Component.new(unread_count:)
          - if helios_dot?
            span.absolute.-top-1.-right-1.rounded-full.bg-amber-400.dark:bg-amber-500.ring-4.ring-indigo-600.dark:ring-indigo-900[
              class="size-2.5 group-has-[#bottom-nav-notification-dot>*]/dots:ring-1"
              aria-hidden="true"
            ]
      span.leading-tight.truncate class="text-[0.65rem]"
        = t('.more')
