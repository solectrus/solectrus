form.relative.isolate.flex.items-center.focus:outline-hidden[
  class=form_class
  data-controller= (ApplicationPolicy.themes? ? 'theme--color-palette-selector--component segment-slide' : 'tooltip')
  data-action= 'click->segment-slide#move'
  title= (t('premium.sponsors_only') unless ApplicationPolicy.themes?)
  data-tooltip-placement-value= 'top'
]
  label.cursor-pointer[
    class= ('pointer-events-none' unless ApplicationPolicy.themes?)
    title= t('.standard')
    data-controller= 'tooltip'
    data-tooltip-placement-value= 'top'
  ]
    input.sr-only.peer[
      type= 'radio'
      name= 'colorPalette'
      value= 'standard'
      data-action= 'theme--color-palette-selector--component#standard'
      data-theme--color-palette-selector--component-target= 'inputStandard'
    ]
    .grid.grid-cols-2.peer-checked:bg-white.dark:peer-checked:bg-gray-700/60.hover:bg-gray-100.dark:hover:bg-gray-800.transition-colors class=tile_class data-segment-slide-target='segment'
      .rounded-sm class=swatch_class style="background-color: var(--palette-standard-preview-battery)"
      .rounded-sm class=swatch_class style="background-color: var(--palette-standard-preview-house)"
      .rounded-sm class=swatch_class style="background-color: var(--palette-standard-preview-wallbox)"
      .rounded-sm class=swatch_class style="background-color: var(--palette-standard-preview-heatpump)"

  label.cursor-pointer[
    class= ('pointer-events-none' unless ApplicationPolicy.themes?)
    title= t('.contrast')
    data-controller= 'tooltip'
    data-tooltip-placement-value= 'top'
  ]
    input.sr-only.peer[
      type= 'radio'
      name= 'colorPalette'
      value= 'contrast'
      data-action= 'theme--color-palette-selector--component#contrast'
      data-theme--color-palette-selector--component-target= 'inputContrast'
    ]
    .grid.grid-cols-2.peer-checked:bg-white.dark:peer-checked:bg-gray-700/60.hover:bg-gray-100.dark:hover:bg-gray-800.transition-colors class=tile_class data-segment-slide-target='segment'
      .rounded-sm class=swatch_class style="background-color: var(--palette-contrast-preview-battery)"
      .rounded-sm class=swatch_class style="background-color: var(--palette-contrast-preview-house)"
      .rounded-sm class=swatch_class style="background-color: var(--palette-contrast-preview-wallbox)"
      .rounded-sm class=swatch_class style="background-color: var(--palette-contrast-preview-heatpump)"
