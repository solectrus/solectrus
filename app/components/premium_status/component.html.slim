- if cell?
  = render Ui::GroupedList::Component.new do |list|
    - list.with_cell(**cell_args)
- else
  .flex.items-start.gap-3.p-4.text-sm class=box_class
    - if icon_name
      = icon icon_name, class: 'fa-fw fa-lg mt-0.5 shrink-0'

    div
      / The name of the state
      span.block.font-semibold
        = title

        - if countdown
          span.font-normal
            = " · #{countdown}"

      / What the state means, and what the user can do about it, each on a
        line of its own
      - if description
        span.block.mt-1
          = description

      - if cta_text
        span.block.mt-2
          = link_to cta_link,
                    class: 'underline underline-offset-2 font-medium',
                    data: { turbo: false } do
            = cta_text
            span.ml-1 &rarr;
