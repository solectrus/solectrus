.h-full.w-full[
  data-controller= 'sequential-frames'
  data-sequential-frames-reload-on-complete-value= true
  data-sequential-frames-total-value= missing_or_stale_days.size
  data-sequential-frames-texts-value= t('.remaining').to_json
  class= "timeframe-#{timeframe.id}"
]
  / A page builds a day or two itself (see Sensor::Summarizer.build_few), so
    the days here are always enough for a progress bar
  .h-full.flex.flex-col.gap-8.items-center.justify-center.text-center.py-20
    h1.text-lg.font-medium.text-fg.md:text-xl id='summary-builder-title'
      = t('.title')

    .w-full.max-w-md.flex.flex-col.gap-2
      .h-2.rounded-full.overflow-hidden.bg-indigo-200.dark:bg-indigo-900[
        role= 'progressbar'
        aria-labelledby= 'summary-builder-title'
        aria-valuemin= 0
        aria-valuemax= 100
        aria-valuenow= 0
        data-sequential-frames-target= 'bar'
      ]
        div class='h-full rounded-full bg-indigo-600 dark:bg-indigo-500 -translate-x-full transition-[translate] ease-linear motion-reduce:transition-none' data-sequential-frames-target='fill'

      / A single frame goes from nothing to all, so it has no figures
      - if chunks.many?
        .flex.justify-between.gap-4.text-sm.text-muted.tabular-nums.lg:text-base
          span data-sequential-frames-target= 'percent'
          span data-sequential-frames-target= 'remaining'

    / The frames only carry the requests, one chunk after the other
    .hidden
      - chunks.each do |chunk|
        = render ChunkComponent.new(from: chunk.first, to: chunk.last, size: chunk.size)
