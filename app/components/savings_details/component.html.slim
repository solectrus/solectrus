.tooltip-layout.tooltip-layout-table
  = render TooltipHeader::Component.new(title: t('.title'))

  dl.tooltip-group
    = render CalcRow::Component.new(label: Sensor::Registry[:grid_import_power].display_name(:short)) do
      = render SensorValue::Component.new(solar_price.parts.first, :grid_costs, sign: :negative, **solar_price.options)
    = render CalcRow::Component.new(label: Sensor::Registry[:grid_export_power].display_name(:short), operator: :plus) do
      = render SensorValue::Component.new(solar_price.parts.last, :grid_revenue, sign: :positive, **solar_price.options)
    = render CalcRow::Component.new(label: Sensor::Registry[:solar_price].display_name(:short), operator: :equals) do
      = render SensorValue::Component.new(solar_price.sum, :solar_price, sign: :value_based_reverse, **solar_price.options)

  dl.tooltip-group
    = render CalcRow::Component.new(label: Sensor::Registry[:traditional_costs].display_name(:short), operator: :minus) do
      = render SensorValue::Component.new(savings.parts.last, :traditional_costs, sign: :negative, **savings.options)
    = render CalcRow::Component.new(label: Sensor::Registry[:savings].display_name(:short), operator: :equals, total: true) do
      = render SensorValue::Component.new(savings.sum, :savings, sign: :value_based, **savings.options)

    - if data.battery_savings_percent&.positive?
      = render CalcRow::Component.new(label: "#{Sensor::Registry[:battery_savings].display_name(:short)} (#{Sensor::ValueFormatter.new(data.battery_savings_percent, unit: :percent)})") do
        = render SensorValue::Component.new(data, :battery_savings, sign: :positive)

  p.tooltip-footnote
    = t('.explanation')
