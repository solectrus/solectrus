/ A table from lg up, every row a subgrid of the list, so the columns line
  up. Below, the same cells form a grouped list: the date and the
  note at the left, the price per kWh and its change at the right. The base
  fee shows in the form.
.grid.gap-x-4.select-text.text-gray-800.dark:text-gray-400.max-lg:block.max-lg:overflow-hidden.max-lg:rounded-xl.max-lg:bg-white.dark:max-lg:bg-slate-800/60 class=grid_columns
  .grid.grid-cols-subgrid.col-span-full.p-2.font-bold.max-lg:hidden
    div
      = Price.human_attribute_name(:starts_at)
    div
    .text-right
      = amount_label
    div
    - if base_fee_column?
      .text-right
        = Price.human_attribute_name(:amount_per_month)

  - prices.each_with_index do |price, index|
    = render Ui::TableRow::Component.new(href: edit_settings_price_path(price), nav_title: t("settings.prices.edit.#{name}"), css_class: 'grid items-center lg:col-span-full lg:grid-cols-subgrid lg:p-2 lg:tabular-nums max-lg:grid-cols-[minmax(0,1fr)_auto_auto] max-lg:grid-rows-[auto_auto] max-lg:gap-y-0.5') do |row|
      = row.link css_class: 'max-lg:col-start-1 max-lg:row-start-1 max-lg:text-headline max-lg:text-gray-800 dark:max-lg:text-slate-300' do
        time.whitespace-nowrap datetime= price.starts_at.iso8601
          = l price.starts_at
      .w-0.min-w-full.truncate.text-sm.text-gray-500.max-lg:col-start-1.max-lg:row-start-2.max-lg:text-subhead.max-lg:text-muted.max-lg:empty:hidden
        = price.note
      .whitespace-nowrap.text-right.tabular-nums.max-lg:col-start-2.max-lg:row-start-1.max-lg:text-muted
        = number_to_currency(price.amount_per_kwh, precision: nil, unit: Currency.symbol)
        span.lg:hidden = t('.per_kwh')
      .whitespace-nowrap.text-sm.min-w-10.text-right.max-lg:col-start-2.max-lg:row-start-2.max-lg:empty:hidden
        = render PriceList::Change::Component.new(price:, previous: prices[index + 1])
      - if base_fee_column?
        .whitespace-nowrap.text-right.max-lg:hidden
          - if price.amount_per_month
            = number_to_currency(price.amount_per_month, precision: 2, unit: Currency.symbol)
