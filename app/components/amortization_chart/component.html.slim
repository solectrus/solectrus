= tag.div class: 'relative flex-auto flex flex-col group/zoom group-data-zoomed/zoom:fixed group-data-zoomed/zoom:inset-0 group-data-zoomed/zoom:z-45 group-data-zoomed/zoom:p-6 group-data-zoomed/zoom:bg-white dark:group-data-zoomed/zoom:bg-slate-900',
          data: { \
            controller: 'amortization-chart--component chart-zoom',
            amortization_chart__component_currency_value: currency_code,
            amortization_chart__component_balance_label_value: t('.balance'),
            amortization_chart__component_today_label_value: t('.today'),
            amortization_chart__component_degree_label_value: t('.degree'),
            amortization_chart__component_break_even_label_value: t('.break_even'),
          } do

  div class='absolute right-0 top-0 flex gap-3 z-10 group-data-zoomed/zoom:right-4 group-data-zoomed/zoom:top-4'
    /! Parameter drawer: adjust period and interest rate without leaving the
    /! chart. Reuses the dropdown controller (toggle + click-outside +
    /! transitions); the panel opens downward so it never pushes the layout.
    /! Desktop only - on mobile the params live in the page header (lg:hidden).
    div class='relative max-lg:hidden' data-controller='dropdown--component'
      button[
        type='button'
        class=ICON_BUTTON_CLASS
        data-dropdown--component-target='button'
        data-action='click->dropdown--component#toggle'
        data-controller='tooltip'
        title=t('.parameters')
        aria-haspopup='true'
        aria-expanded='false'
      ]
        i.fa.fa-sliders
      div[
        class='absolute top-full right-0 z-20 mt-2 hidden w-96 max-w-[calc(100vw-2rem)] rounded-lg bg-white dark:bg-gray-800 p-4 text-left shadow-lg ring-1 ring-black/5'
        data-dropdown--component-target='menu'
        data-transition-enter='transition ease-out duration-100'
        data-transition-enter-start='opacity-0 scale-95'
        data-transition-enter-end='opacity-100 scale-100'
        data-transition-leave='transition ease-in duration-75'
        data-transition-leave-start='opacity-100 scale-100'
        data-transition-leave-end='opacity-0 scale-95'
      ]
        = render AmortizationControls::Component.new(result:)

    button[
      class="#{ICON_BUTTON_CLASS} group-data-zoomed/zoom:hidden max-lg:hidden"
      data-chart-zoom-target='maximizeBtn'
      data-action='chart-zoom#maximize'
      data-controller='tooltip'
      title=t('.maximize')
    ]
      i.fa.fa-up-right-and-down-left-from-center

    button[
      class="#{ICON_BUTTON_CLASS} hidden group-data-zoomed/zoom:flex"
      data-action='chart-zoom#minimize'
      data-controller='tooltip'
      title=t('.minimize')
    ]
      i.fa.fa-down-left-and-up-right-to-center

  div class='hidden text-center group-data-zoomed/zoom:block group-data-zoomed/zoom:relative group-data-zoomed/zoom:z-6'
    div class='md:inline-flex md:items-baseline md:gap-2'
      div class='font-bold text-gray-800 dark:text-gray-200'
        = t('layout.amortization')
      - if period_label
        div class='font-normal text-gray-500 dark:text-gray-400'
          = period_label

  script type='application/json' data-amortization-chart--component-target='data'
    == chart_data.to_json

  div class='invisible flex absolute inset-0 items-center justify-center bg-white dark:bg-slate-900 z-5 [&_.delayed-fade-in]:opacity-100 [&_.delayed-fade-in]:animate-none' data-chart-zoom-target='loading'
    = render Loading::Component.new

  .relative.mt-2.flex-1.min-h-52
    canvas.max-w-full data-amortization-chart--component-target='canvas'
