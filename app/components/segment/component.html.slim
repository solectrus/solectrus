- if block
  = tag.div id: "segment-#{sensor.name}",
            class: ['segment', color_class, ('border-0!' if tiny?), ('hidden' if hidden), ('segment-inline' if inline)],
            style: "height: #{percent.round(1)}%; --icon-scale: #{icon_scale / 100.0}",
            title:,
            data: { \
              controller: tooltip ? 'tooltip' : nil,
              tooltip_placement_value: parent.tooltip_placement,
              tooltip_force_tap_to_close_value: false,
              tooltip_touch_value: 'long',
            } do
    = block.call

- else
  = link_to_or_div url,
            id: "segment-#{sensor.name}",
            class: ['segment', color_class, ('border-0!' if tiny?), ('hidden' if hidden), ('segment-inline' if inline), ('group' if url)],
            style: "height: #{percent.round(1)}%; --icon-scale: #{icon_scale / 100.0}",
            title:,
            data: { \
              controller: tooltip ? 'tooltip' : nil,
              tooltip_placement_value: parent.tooltip_placement,
              tooltip_force_tap_to_close_value: false,
              tooltip_touch_value: 'long',
              tooltip_sheet_url_value: insights_path,
              turbo_prefetch: 'false',
              action: 'stats-with-chart--component#loadChart',
              stats_with_chart__component_sensor_name_param: sensor.name,
              stats_with_chart__component_chart_url_param: chart_url,
            } do
    .content class= "#{'click-animation' if url}"
      - unless inline
        = render SensorIcon::Component.new(sensor, data:, class: 'icon')

      .font-light.leading-tight.title
        = title.truncate(25)

      .value data= { 'stats-with-chart--component-target': 'current', 'sensor-name': sensor.name, value: masked_value, time: data.time&.to_i }
        = render SensorValue::Component.new(data, sensor.name, context: now? ? :rate : :total)

      - if sensor.name == :grid_export_power && data.respond_to?(:grid_export_limit_active?) && data.grid_export_limit_active?
        = icon 'circle-exclamation'

      .hidden id="tooltip-content-#{sensor.name}" data-tooltip-target="html"
        .tooltip-layout.label-value-stacked
          = render TooltipHeader::Component.new(title:, sensor_name: sensor.name, value: data, total: !now?) do |header|
            - unless inline
              - header.with_icon do
                = render SensorIcon::Component.new(sensor, data:, class: 'tooltip-icon fa-2xl')

            - if amount
              = render SensorValue::Component.new(data, amount.first, sign: amount.last, class: 'tooltip-value-lg')

          - if now?
            - if sensor.name == :grid_export_power && data.respond_to?(:grid_export_limit_active?) && data.grid_export_limit_active?
              .tooltip-group.tooltip-group-sm
                .label-value-row.label-value-column
                  span = Sensor::Registry[:grid_export_limit].display_name(:short)
                  = render SensorValue::Component.new(data, :grid_export_limit, precision: 0)

          - elsif costs || power_grid_ratio
            / The battery has a grid share but no costs of its own -- what it
            / stores is billed to the consumers taking it back out
            = render SplittedCosts::Component.new(power_grid_ratio:, costs:, grid_costs: costs_grid, pv_costs: costs_pv, note: costs_note)

          - if sensor.name == :inverter_power && Sensor::Config.multi_inverter?
            .tooltip-group
              - Sensor::Config.custom_inverter_sensors.reverse_each do |inverter_sensor|
                - if data.respond_to?(inverter_sensor.name)
                  .label-value-row
                    span = inverter_sensor.display_name
                    span.tabular-nums
                      = render SensorValue::Component.new(data, inverter_sensor.name, context: now? ? :rate : :total, precision: 3)

          - if sensor.name == :inverter_power && data.respond_to?(:co2_reduction) && data.co2_reduction&.nonzero?
            .tooltip-group
              .label-value-row.label-value-column
                span = Sensor::Registry[:co2_reduction].display_name(:short)
                = render SensorValue::Component.new(data, :co2_reduction, class: 'tooltip-value-lg')
