/ Over the chart and below the chart menu. Only the card takes the pointer,
/ so the chart around it still moves.
.absolute.inset-0.z-5.flex.items-center.justify-center.p-4.pointer-events-none
  .pointer-events-auto.max-w-sm.rounded-xl.px-6.py-5.text-center.shadow-lg.backdrop-blur-sm class='bg-white/90 dark:bg-slate-900/90'
    = icon 'lock', class: 'text-3xl text-slate-400 dark:text-slate-500'
    p.mt-3.text-lg.font-semibold.text-slate-700.dark:text-slate-200
      = t('.title')
    p.mt-1.text-sm.text-slate-500.dark:text-slate-400
      = t('.body')
    .mt-4
      = render Button::Component.new(title: t('layout.login'), path: helpers.new_session_path, style: :primary)
