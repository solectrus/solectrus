- if grouped?
  - if sensor_groups.any?
    .justify-center.flex.items-center
      = render Ui::Dropdown::Component.new name: 'sensor-selector',
                                           items: sensor_groups,
                                           top_item: top_sensor,
                                           bottom_item: bottom_sensor,
                                           selected: selected_id,
                                           display_name: display_name,
                                           menu_position:,
                                           look: :plain
- elsif sensor_items.any?
  .justify-center.flex.items-center
    = render Ui::Dropdown::Component.new name: 'sensor-selector',
                                         items: sensor_items,
                                         top_item: top_sensor,
                                         bottom_item: bottom_sensor,
                                         selected: selected_id,
                                         display_name: display_name,
                                         menu_position:,
                                         look: :plain
