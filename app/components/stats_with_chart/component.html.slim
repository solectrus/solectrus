- if !timeframe.relative? || ApplicationPolicy.relative_timeframe?
  / A page with a layout of its own places the frames with its block
  - if Sensor.data? && content?
    = content
  - else
    = tag.turbo_frame id: frame_id('stats-content'), class: 'flex-auto min-h-20 flex' do
      - if Sensor.data?
        div class='flex-1 min-h-0 flex flex-col lg:landscape:flex-row gap-5' data=refresh_options
          - unless year_comparison?
            = stats_frame(stats_class)
          - if chart?
            = chart_frame('flex-1 min-h-20 flex relative')
      - else
        .flex-1.flex.items-center.justify-center
          = render EmptyState::Component.new
- else
  = render DemoLink::Component.new feature: 'relative_timeframe',
                                   url: { **controller.__send__(:permitted_params) }
