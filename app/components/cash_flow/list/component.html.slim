- if cash_flows.any?
  = render Ui::AmountTable::Component.new(headers:, grid_columns: 'grid-cols-[auto_auto_minmax(0,1fr)_auto]', total:, unit: Currency.symbol) do
    - cash_flows.each do |cash_flow|
      = render CashFlow::List::Row::Component.new(cash_flow:, filter:)
- else
  = render empty_state
