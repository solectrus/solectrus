- if summaries_incomplete?
  /! Build the missing daily summaries first, then reload.
  .flex-1.min-h-0
    = render SummaryBuilder::Component.new(timeframe:, missing_or_stale_days:)
- elsif result.prognosis?
  /! Both views fill the remaining height. The details view is the table
  /! alone, so it becomes its own scroll area and keeps its heading row
  /! pinned; the chart view carries the compact KPI rail on top.
  - if view == :details
    = render AmortizationTable::Component.new(result:)
  - elsif view == :returns
    /! History of the return - a chart of its own, no KPI rail: the rail's
    /! figures are all end-of-period values and would compete with the
    /! curve's story of how the rate got where it is.
    .flex-1.min-h-0.flex.flex-col
      = render AmortizationReturnChart::Component.new(result:)
  - else
    /! KPI rail. Kept in the DOM even when hidden on very short viewports
    /! (sr-only, not display:none) so the figures stay available to screen
    /! readers and the specs.
    div class='tiny:sr-only'
      = render AmortizationStats::Component.new(result:)

    .flex-1.min-h-0.flex.flex-col
      = render AmortizationChart::Component.new(result:)
- else
  /! Not enough measured data yet - degree teaser shows the reason
  .flex-1.min-h-0.flex.flex-col.justify-center.gap-6
    = render AmortizationDegree::Component.new(result:)
