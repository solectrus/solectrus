- if !permitted?
  = render DemoLink::Component.new(feature: permitted_feature_name, url: demo_url)
- elsif blank? && !empty_axes?
  / A chart that lacks data says so. A chart that is empty as a normal
    state, like a day without a drive, draws its empty axes below.
  .flex-1.flex.items-center.justify-center
    = render Ui::EmptyState::Component.new(icon: 'chart-line', title: blank_message, size: :small)
- else
  = tag.div class: "h-full #{ZOOM_CLASSES}",
            data: { \
              controller: 'chart-loader--component chart-zoom',
              chart_loader__component_type_value: type,
              chart_loader__component_unit_value: unit,
              chart_loader__component_decimals_value: decimals,
              chart_loader__component_scalable_value: scalable?,
              chart_loader__component_currency_value: currency,
              chart_loader__component_source_label_value: I18n.t('balance_sheet.left'),
              chart_loader__component_usage_label_value: I18n.t('balance_sheet.right'),
              chart_zoom_zoom_interval_value: zoom_interval,
            } do
    / The buttons stand at the top right, beside the chart menu
    div class=CONTROLS_CLASS
      - if path_to_insights
        = link_to path_to_insights,
                  class: "#{ICON_BUTTON_CLASS} group-data-zoomed/zoom:hidden",
                  data: Ui::TurboModal::Component.link_data(tooltip: true),
                  title: t('layout.insights') do
          = icon 'lightbulb', class: 'fa-lg'

      button[
        class="#{ICON_BUTTON_CLASS} group-data-zoomed/zoom:hidden"
        data-chart-zoom-target='maximizeBtn'
        data-action='chart-zoom#maximize'
        data-controller='tooltip'
        title=t('.maximize')
      ]
        = icon 'up-right-and-down-left-from-center'

      button[
        class="#{ICON_BUTTON_CLASS} hidden group-data-zoomed/zoom:flex"
        data-action='chart-zoom#minimize'
        data-controller='tooltip'
        title=t('.minimize')
      ]
        = icon 'down-left-and-up-right-to-center'

    / The title spans the full width beside the buttons, so clicks pass through
    div class='hidden text-center pointer-events-none group-data-zoomed/zoom:block group-data-zoomed/zoom:relative group-data-zoomed/zoom:z-6'
      div class='md:inline-flex md:items-baseline md:gap-2'
        div class='font-bold text-gray-800 dark:text-gray-200'
          = sensor.display_name
        div class='font-normal text-gray-500 dark:text-gray-400'
          = timeframe.localized

    script type= 'application/json' data-chart-loader--component-target= 'data'
      == data.to_json

    script type= 'application/json' data-chart-loader--component-target= 'options'
      == chart_options.to_json

    div class='invisible flex absolute inset-0 items-center justify-center bg-white dark:bg-slate-900 z-5 [&_.delayed-fade-in]:opacity-100 [&_.delayed-fade-in]:animate-none' data-chart-zoom-target='loading'
      = render Ui::Loading::Component.new

    .flex-1.min-h-20.w-full.max-w-full.overflow-hidden.box-border.relative data-chart-loader--component-target= 'container'
      = tag.canvas id: "chart-#{timeframe.id}",
                   class: 'max-w-full flex-1',
                   data: { \
                     chart_loader__component_target: 'canvas',
                     stats_with_chart__component_target: 'canvas',
                   }

  - if show_forecast_comment?
    = render Forecast::Comment::Component.new(chart:, timeframe:)
