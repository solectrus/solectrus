.soc-badge.badge[
  class= 'flex flex-col gap-1 rounded-3xl xl:tall:bg-slate-200 dark:xl:tall:bg-slate-800'
  style= "--value: #{percent};"
]
  = link_to balance_home_path(sensor_name: 'battery_soc', timeframe:),
            data: chart_data('battery_soc', battery_soc),
            class: 'click-animation' do
    .soc-row class= 'w-full flex items-center justify-between gap-1 px-1 xl:px-3'
      = icon 'house', class: 'fa-sm soc-icon text-slate-500 dark:text-slate-400'
      span.soc-value class= ['font-medium', color_class(:battery_soc, battery_soc)]
        = "#{battery_soc.round}%"

  = link_to balance_home_path(sensor_name: car_sensor_name, timeframe:),
            data: chart_data(car_sensor_name, car_soc),
            class: 'click-animation' do
    .soc-row class= 'w-full flex items-center justify-between gap-1 px-1 xl:px-3'
      = icon 'car', class: ['fa-sm soc-icon', car_icon_class]
      span.soc-value class= ['font-medium', color_class(car_sensor_name, car_soc)]
        = "#{car_soc.round}%"

  .title class= 'mx-auto uppercase tracking-tight text-slate-500 dark:text-slate-400'
    = t('.soc')
