.trend-overview
  / No sensor of the page has data in the periods, like on a new system
  - if sections.empty?
    = render Ui::EmptyState::Component.new(icon: 'arrow-trend-up', title: t('data.blank'), size: :small)

  - sections.each do |group, lists|
    section
      - if group
        h2.trend-overview-header = t(".groups.#{group}")
      - lists.each do |rows|
        ul.trend-overview-group
          - rows.each do |row|
            li
              - url = href(row)
              = content_tag(url ? :a : :div, class: 'trend-overview-row', href: url, data: { nav_title: (label(row) if url) }) do
                span.trend-overview-name = label(row)
                = render trend(row)
                - if url
                  = icon 'chevron-right', class: 'trend-overview-chevron'
