- if places.empty?
  = render Ui::EmptyState::Component.new(icon: 'location-dot', title: t('settings.places.empty_title'), text: t('settings.places.empty'))
- else
  .grid.w-full.max-lg:block.max-lg:overflow-hidden.max-lg:rounded-xl.max-lg:bg-surface class="grid-cols-[auto_minmax(0,1fr)_auto]"
    = render Place::List::Rows::Component.new(places:, pagy:)
