- if visits.empty?
  = render Ui::EmptyList::Component.new(icon: 'location-dot', text: t('visits.empty'))
- else
  / The desktop has a table, a phone a grouped list (see the row).
    One container for both, so the pages of the list load once.
  / The place has two columns: its name, and where it is.
  .grid.w-full.max-lg:flex.max-lg:flex-col class=%w[lg:grid-cols-[auto_auto_minmax(0,1fr)_auto] lg:grid-cols-[auto_auto_auto_minmax(0,1fr)_auto] lg:grid-cols-[auto_auto_auto_auto_minmax(0,1fr)_auto]][context.icon_columns]
    .col-span-full.grid.grid-cols-subgrid.text-gray-800.dark:text-gray-400.font-bold.max-lg:hidden
      .p-2 = t('visits.period')
      - if context.car_column?
        .p-2 = Car.model_name.human
      - if context.label_column?
        / The column of the icons has no title
        .py-2.pl-2
      .p-2.col-span-2 = Place.model_name.human
      .p-2.text-right = t('visits.duration')
    .lg:contents.max-lg:overflow-hidden.max-lg:rounded-xl.max-lg:bg-white.dark:max-lg:bg-slate-800/60
      = render Place::VisitList::Rows::Component.new(visits:, pagy:, context:)
