/ A row of the table from lg up: the icon, the day, the times, the place with
  its locality, the car and the duration. Below, the same cells form a cell of
  a grouped list in two lines: the icon, the place and the duration, then the
  day, the times and the car below the place.
= render Ui::TableRow::Component.new(href: edit_path, nav_title: t('settings.places.edit'), css_class: 'grid items-center lg:col-span-full lg:grid-cols-subgrid max-lg:grid-cols-[auto_minmax(0,1fr)_auto_auto] max-lg:grid-rows-[auto_auto] max-lg:gap-y-0.5') do |row|
  .lg:p-2.max-lg:row-span-2
    = render Place::Icon::Component.new(place: visit.place)
  .hidden.lg:block.p-2.whitespace-nowrap
    time datetime=visit.started_at.iso8601 = date
  .hidden.lg:block.p-2.whitespace-nowrap.tabular-nums.text-fg-secondary
    = times
  .min-w-0.lg:p-2.max-lg:col-start-2.max-lg:row-start-1
    = row.link css_class: 'block truncate text-fg' do
      = render Place::VisitList::NameCell::Component.new(place: visit.place)
      = render Place::VisitList::LocalityCell::Component.new(place: visit.place)
  .lg:hidden.min-w-0.truncate.col-start-2.row-start-2.text-subhead.text-muted.tabular-nums
    = phone_line
  - if context.car_column?
    .hidden.lg:flex.min-w-0.p-2
      = render Car::Badge::Component.new(car: visit.car, short: true)
  .tabular-nums.text-right.whitespace-nowrap.font-semibold.text-fg.lg:p-2.max-lg:col-start-3.max-lg:row-span-2.max-lg:font-normal
    = DurationText.call(visit.current_seconds)
