= render Ui::LazyRows::Component.new(prefix: FRAME_PREFIX, pagy:, frame:) do
  - rows.each do |row|
    = render Place::VisitedList::Row::Component.new(place: places[row.place_id], cars: cars.values_at(*row.car_ids).compact, visit_count: row.visit_count, last_started_at: row.last_started_at, visits_href: visits_path.call(row.place_id))
