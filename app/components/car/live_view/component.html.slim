/ A phone fills the height with the cards, and scrolls through more than fit.
  A line parts the cards one below the other.
div class='flex-1 min-h-0 flex flex-col gap-3.5 overflow-y-auto max-sm:divide-y max-sm:divide-slate-200 dark:max-sm:divide-slate-700 sm:flex-row sm:justify-center sm:gap-5'
  - if states.empty?
    div class=[Car::LiveShell::Component::CARD, card_classes, 'flex-1 items-center justify-center p-4']
      = render Car::NoneInUse::Component.new(text: t('data.car_none_in_use_now'))

  - states.each do |state|
    div class=['flex flex-col min-h-fit sm:flex-1 sm:min-h-0', card_classes]
      = render Car::LiveCard::Component.new(state:, compact: cards > 1)

  / The power of the wallbox, for a charge of no car
  - if wallbox?
    - title = t(guest? ? 'car_breakdown.guest_short' : 'car_breakdown.wallbox_short')
    = render Car::LiveShell::Component.new(label: title, time: wallbox_time, css_class: card_classes) do |card|
      - card.with_title do
        = icon 'charging-station'
        = title
      div class='flex-1 flex flex-col items-center justify-center gap-1.5'
        span.text-5xl.lg:text-7xl.font-semibold.leading-none.tabular-nums.whitespace-nowrap.text-signal-positive
          = render Sensor::Value::Component.new(live.data, :wallbox_power, context: :rate)
        span.text-sm.text-slate-500.dark:text-slate-400.lg:uppercase.lg:tracking-wider
          = t('.charging')
