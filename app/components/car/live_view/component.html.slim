/ A phone shows the cards one below the other. The live view grows with its
  cards, and the window scrolls through more than fit (see the car page).
div class='flex-1 flex flex-col gap-2 sm:flex-row sm:justify-center sm:gap-5'
  - if states.empty?
    div class=[Car::LiveShell::Component::CARD, card_classes, 'flex-1 items-center justify-center p-4', Car::LiveCard::Component::GROUND]
      = render Car::NoneInUse::Component.new(text: t('data.car_none_in_use_now'))

  - states.each do |state|
    div class=['flex flex-col min-h-fit sm:min-h-0', (cards == 1 ? 'flex-1' : 'sm:flex-1'), card_classes]
      = render Car::LiveCard::Component.new(state:, compact: cards > 1)

  / The power of the wallbox, for a charge of no car
  - if wallbox?
    - title = t(guest? ? 'car_breakdown.guest_short' : 'car_breakdown.wallbox_short')
    = render Car::LiveShell::Component.new(label: title, time: wallbox_time, css_class: card_classes) do |card|
      - card.with_title do
        = icon 'charging-station'
        = title
      div class=['flex-1 flex flex-col items-center justify-center gap-1.5 rounded-2xl p-6', Car::LiveCard::Component::GROUND]
        span.text-5xl.lg:text-7xl.font-semibold.leading-none.tabular-nums.whitespace-nowrap.text-signal-positive
          = render Sensor::Value::Component.new(live.data, :wallbox_power, context: :rate)
        span.text-sm.text-muted.lg:uppercase.lg:tracking-wider
          = t('.charging')
