.hidden data-tooltip-target='html'
  - if parts.any?
    .tooltip-layout.tooltip-layout-table
      - if colored.any?
        .tooltip-group
          - colored.each do |part|
            = render Tooltip::Row::Component.new(label: part.label, color: part.color) do
              = part.value
              - if part.percent
                span.inline-block.w-14.text-right.font-normal.text-muted = "#{part.percent} %"
      - if details.any?
        .tooltip-group
          - details.each do |part|
            .label-value-row
              span.tooltip-row-label = part.label
              span.font-semibold.whitespace-nowrap = part.value
      - if notes.any?
        .tooltip-group
          .max-w-72.space-y-2.text-left.text-sm.font-normal.text-muted
            - notes.each do |note|
              p = note
  - else
    .max-w-72.space-y-2.text-left
      - notes.each do |note|
        p = note
