section class='@container flex flex-col lg:flex-1 max-lg:gap-2 max-lg:shrink-0' aria-labelledby=heading_id
  / The title and the link to the list of the column. The head keeps the
    height of its button, also without it.
  div class='box-content flex items-center justify-between min-h-8 max-lg:px-1 lg:min-h-9 lg:pb-3'
    / A note, like the window of the rates, in an info icon beside the title
    div class='flex items-center gap-2'
      h2 id=heading_id class='text-xl font-semibold text-fg'
        = title
      - if note
        = render Ui::InfoIcon::Component.new(text: note, position: 'relative', icon_class: 'text-sm text-faint')
    / A phone has a link beside the title of the group, the desktop a pill.
      Open tasks of the list put an amber dot after its label.
    - if list
      - notes = capture do
        - if list.notes.any?
          span.shrink-0.size-2.rounded-full.bg-attention-strong aria-hidden='true'
          span.sr-only = list.notes.join(', ')
      = link_to list.sheet_href || list.href, data: (Ui::TurboModal::Component.link_data if list.sheet_href), class: 'lg:hidden relative touch-target flex items-center gap-1 min-h-8 rounded-lg px-2 text-sm font-medium text-fg-secondary active:bg-fill-strong focus-ring click-animation' do
        = list.label
        = notes
        = icon 'chevron-right', class: 'text-xs text-faint'
      = link_to list.href, class: 'max-lg:hidden flex items-center gap-2 rounded-full px-3 py-1.5 text-base font-medium text-fg-secondary hover:bg-fill focus-ring click-animation' do
        = list.label
        = notes
        = icon 'chevron-right', class: '-ml-1 text-sm text-faint'

  / A period without a value has a crossed out icon and a text in the middle
    of the box. A hidden lead and bar below them keep the height of the box.
  - if empty
    div class='relative rounded-xl bg-fill lg:flex-1'
      div class='invisible flex flex-col gap-3 p-3 lg:gap-4 lg:px-5 lg:py-4' aria-hidden='true'
        span class='text-3xl leading-none @md:text-4xl' &nbsp;
        = render bar.value if bar
      / The icon and the text like a small Ui::EmptyState
      div class='absolute inset-0 flex items-center justify-center gap-3 px-3'
        = helpers.slashed_icon empty.icon, class: 'shrink-0 text-xl text-faint @md:text-2xl'
        span.truncate.text-base.font-medium.text-fg-secondary = empty.text
  - else
    / The lead on the left, the other figures beside it. The lead keeps its
      line, so where the box is too narrow, the other figures stand one below
      the other on the right. The bar stands at the bottom, so the bars of
      both columns line up. The unit of the lead stays small, so its number
      stands out.
    div class='flex flex-col justify-between gap-3 rounded-xl bg-fill p-3 lg:flex-1 lg:gap-4 lg:px-5 lg:py-4'
      div class='flex items-baseline justify-between gap-x-6'
        = figure_tag(lead, placement: 'right', class: '-mx-2 -my-1 shrink-0 rounded-lg px-2 py-1 focus-ring') do
          span class='text-3xl font-semibold leading-none tabular-nums whitespace-nowrap text-fg @md:text-4xl [&_.sensor-value-unit]:text-xl [&_.sensor-value-unit]:font-normal [&_.sensor-value-unit]:text-muted'
            = lead.value
          - if lead.tooltip?
            = render tooltip(lead)
        div class='-mx-2 flex min-w-0 flex-wrap justify-end text-sm @md:text-base'
          - side_figures.each do |figure|
            = figure_tag(figure, class: 'rounded-lg px-2 py-0.5 focus-ring') do
              span.font-semibold.tabular-nums.whitespace-nowrap.text-fg = figure.value
              - if figure.title
                span.sr-only = figure.title
              - if figure.tooltip?
                = render tooltip(figure)
      - if bar
        = figure_tag(bar, class: 'block rounded-lg focus-ring', link_class: 'cursor-pointer click-animation lg:hover:brightness-95') do
          = render bar.value
          - if bar.tooltip?
            = render tooltip(bar)
