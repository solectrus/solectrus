section class='@container flex flex-col lg:flex-1 max-lg:gap-2 max-lg:shrink-0' aria-labelledby=heading_id
  / The title and the link to the list of the column. The head keeps the
    height of its button, also without it.
  div class='box-content flex items-center justify-between min-h-8 max-lg:px-1 lg:min-h-9 lg:pb-3'
    / A note, like the window of the rates, in an info icon beside the title.
      The swatch before the title has the colors of the bars of the column in
      the timeline of a day, its parts stacked from the bottom like there.
    div class='flex items-center gap-2'
      span class='flex flex-col-reverse gap-px overflow-hidden rounded-sm h-5 w-7' aria-hidden='true'
        - swatch.each do |segment|
          span class='basis-0' style="flex-grow: #{segment.percent}; background: #{segment.color}"
      h2 id=heading_id class='text-xl font-semibold text-fg'
        = title
      - if note
        = render Ui::InfoIcon::Component.new(text: note, position: 'relative', icon_class: 'text-sm text-faint')
    / A phone has a link beside the title of the group, the desktop a pill.
      Open tasks of the list put an amber dot after its label.
    - if list
      - notes = capture do
        - if list.notes.any?
          span.shrink-0.size-2.rounded-full.bg-attention-strong aria-hidden='true'
          span.sr-only = list.notes.join(', ')
      = link_to list.sheet_href || list.href, data: (Ui::TurboModal::Component.link_data if list.sheet_href), class: 'lg:hidden relative touch-target flex items-center gap-1 min-h-8 rounded-lg px-2 text-sm font-medium text-fg-secondary active:bg-fill-strong focus-ring click-animation' do
        = list.label
        = notes
        = icon 'chevron-right', class: 'text-xs text-faint'
      = link_to list.href, class: 'max-lg:hidden flex items-center gap-2 rounded-full px-3 py-1.5 text-base font-medium text-fg-secondary hover:bg-fill focus-ring click-animation' do
        = list.label
        = notes
        = icon 'chevron-right', class: '-ml-1 text-sm text-faint'

  / The figures in a row: one box with a line between them. The value comes
    first, its caption below it says what it counts, since the title of the
    group says the rest. The figures share the width equally, but a long
    value, like 12.969 kWh, takes the width it needs from the others.
  div class='grid rounded-xl bg-fill lg:flex-1' style="grid-template-columns: repeat(#{figures.size}, minmax(min-content, 1fr))"
    - figures.each_with_index do |figure, index|
      = figure_tag(figure.sensor_name, tooltip: figure.tooltip?, class: figure_classes(index)) do
        span class='text-lg font-semibold leading-tight tabular-nums whitespace-nowrap text-fg @min-[22rem]:text-xl @md:text-2xl'
          = figure.value
        - if figure.wide_label
          span.truncate.text-sm.text-muted.lg:hidden = figure.label
          span.truncate.text-sm.text-muted.max-lg:hidden = figure.wide_label
        - else
          span.truncate.text-sm.text-muted = figure.label
        - if segments(figure).any?
          / The parts of the value side by side, like the sources of the
            charged energy, which the tooltip of the energy names
          span class='mt-1 flex h-1.5 w-full max-w-36 gap-0.5 overflow-hidden rounded-full' aria-hidden='true'
            - segments(figure).each do |segment|
              span style="flex-grow: #{segment.percent}; background: #{segment.color}"
        - if figure.tooltip?
          = render Car::OverviewBox::Tooltip::Component.new(parts: figure.parts, notes: figure.notes, bar: figure.bar)
