section class='@container flex flex-col lg:flex-1 max-lg:gap-1 max-lg:shrink-0' aria-labelledby=heading_id
  / The title and the link to the list of the column. The head keeps the
    height of its button, also without it.
  div class='box-content flex items-center justify-between min-h-8 max-lg:px-1 lg:pb-3'
    h2 id=heading_id class='text-sm font-semibold uppercase tracking-wide text-muted lg:text-xl lg:normal-case lg:tracking-normal lg:text-fg'
      = title
    / A phone has a link beside the title of the group, the desktop a pill.
      Open tasks of the list put an amber dot after its label.
    - if list
      - notes = capture do
        - if list.notes.any?
          span.shrink-0.size-2.rounded-full.bg-attention-strong aria-hidden='true'
          span.sr-only = list.notes.join(', ')
      = link_to list.href, class: 'lg:hidden flex items-center gap-1 min-h-8 rounded-lg px-2 text-sm font-medium text-fg-secondary active:bg-fill-strong focus-ring click-animation' do
        = list.label
        = notes
        = icon 'chevron-right', class: 'text-xs text-faint'
      = link_to list.href, class: 'max-lg:hidden flex items-center gap-2 rounded-full bg-fill px-3.5 py-1.5 text-sm font-medium text-fg-secondary hover:bg-fill-strong focus-ring click-animation' do
        = icon list.icon, class: 'text-muted'
        = list.label
        = notes
        = icon 'chevron-right', class: 'text-xs text-faint'

  / The desktop: the head with the ring and the main number, and a tile for
    each further figure, all soft boxes with the same edges and gray. A wide
    column has the tiles on the right of the head, one below the other, so
    the head takes no more room than it fills. A lone tile there has the
    height of the head, with its content in the middle. A narrow column has
    the tiles below the head, side by side.
  div class='max-lg:hidden mb-2 flex flex-col gap-3 @min-[35rem]:flex-row @min-[35rem]:min-h-46'
    = figure_tag(head.sensor_name, tooltip: head.parts.any?, class: [BOX_CLASS, 'flex items-center gap-6 @min-[35rem]:flex-1 @min-[35rem]:gap-4']) do
      / The parts of the main number show in the tooltip of the head, below
        it, like the tooltip of a tile. The ring leaves room around the text
        in its center.
      span class=ring_classes style=ring_style
        span class='flex flex-col items-center justify-center size-24 @min-[35rem]:size-22 rounded-full bg-surface text-center'
          - if head.center
            span.text-lg.font-bold.leading-tight.tabular-nums.text-fg = head.center
          - if head.center_label
            span.text-sm.leading-tight.text-muted = head.center_label
      span class='text-4xl @min-[35rem]:text-[2rem] font-semibold leading-none tabular-nums whitespace-nowrap text-fg' aria-label=head.label
        = head.value
      / A screen reader reads the parts, which the tooltip shows
      - if head.parts.any?
        = render Car::OverviewBox::Tooltip::Component.new(parts: head.parts)
        span.sr-only = safe_join(head.parts.map { safe_join([it.label, it.value, "#{it.percent} %"], ' ') }, ', ')

    / A figure without a bar keeps the height of one with a bar, so the two
      columns align
    - if figures.any?
      div class='grid gap-3 @min-[35rem]:flex @min-[35rem]:flex-col @min-[35rem]:w-50 @min-[35rem]:shrink-0' style="grid-template-columns: repeat(#{figures.size}, minmax(0, 1fr))"
        - figures.each do |figure|
          = figure_tag(figure.sensor_name, tooltip: figure.tooltip?, class: [BOX_CLASS, 'flex flex-col gap-1.5 min-h-21.5 @min-[35rem]:flex-1 @min-[35rem]:justify-center', ('@min-[35rem]:items-center @min-[35rem]:text-center' if figures.one?)]) do
            span.text-sm.text-fg-secondary = figure.label
            span.text-2xl.font-semibold.leading-none.tabular-nums.whitespace-nowrap.text-fg = figure.value
            - if figure.bar
              = render figure.bar
            - if figure.tooltip?
              = render Car::OverviewBox::Tooltip::Component.new(parts: figure.parts, notes: figure.notes)

  / A phone: a row of three tiles, soft boxes like the tiles of the desktop.
    Each tile has the height of one with a note or a bar, so a row keeps its
    height when its figures replace the placeholder, whatever they hold.
  div class='lg:hidden grid gap-2' style="grid-template-columns: repeat(#{tiles.size}, minmax(0, 1fr))"
    - tiles.each do |tile|
      = figure_tag(tile.sensor_name, tooltip: tile.tooltip?, class: 'flex min-w-0 min-h-22 flex-col gap-1 rounded-xl px-2 py-2 text-left bg-fill active:bg-fill-strong') do
        span.truncate.text-sm.text-fg-secondary = tile.label
        span.text-lg.font-semibold.leading-tight.tabular-nums.whitespace-nowrap.text-fg = tile.value
        - if tile.bar
          = render tile.bar
        - elsif tile.note
          / The decimals and the unit of a note keep its size, smaller would not read
          span class='truncate text-sm text-muted [&_small]:text-[1em]' = tile.note
        - if tile.tooltip?
          = render Car::OverviewBox::Tooltip::Component.new(parts: tile.parts, notes: tile.notes)
