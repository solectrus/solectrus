section class=[CARD, css_class, 'sm:flex-1 gap-3 lg:gap-6 py-4 lg:py-7'] aria-label=label
  .flex.items-center.justify-between.gap-3
    span class='flex items-center gap-2 lg:gap-2.5 min-w-0 text-lg lg:text-2xl font-semibold text-fg'
      = title
    - if time
      span.shrink-0.text-sm.lg:text-base.text-muted.tabular-nums title=time_title data-controller=('tooltip' if time_title)
        = time
  = content
