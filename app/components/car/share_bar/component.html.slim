/ Each form of a label is hidden until the controller shows the one that fits
div[class=['flex h-9 gap-0.5 overflow-hidden rounded-lg bg-fill-strong', ('animate-pulse motion-reduce:animate-none' if pulse)]
    role=('img' if label)
    aria-label=label
    aria-hidden=('true' unless label)
    data-controller='car--share-bar--component']
  - segments.each do |segment|
    span class=segment_classes(segment) style=segment_style(segment) data-car--share-bar--component-target='segment'
      - segment.labels.each do |form|
        span.flex.items-center.gap-1.5 hidden=true = form
