- case state
- when :none
  = render Ui::EmptyState::Component.new(icon: 'car', title: t('.none_title'), text: t(report.cars.many? ? '.none_all' : '.none')) do
    - settings_buttons.each do |button|
      = render button
- when :no_prices
  = render Ui::EmptyState::Component.new(icon: 'car', title: t('.no_prices_title'), text: t('.no_prices'), slashed: true)
- when :no_distance
  = render Ui::EmptyState::Component.new(icon: 'car', title: t('.no_distance_title'), text: t('.no_distance'), slashed: true)
- else
  / A desktop shows the sections without a card, apart by space. The page
    renders the car without PV too, and a button shows it. The charts read
    the attribute, too.
  div[
    class='group/comparison flex flex-auto flex-col space-y-4 md:space-y-6 lg:space-y-10 text-slate-700 dark:text-slate-300'
    data-controller='car--comparison-page--component without-pv-toggle'
    data-without-pv-toggle-cookie-value=WITHOUT_PV_COOKIE
    data-without-pv=without_pv?
  ]
    = render Car::ComparisonWarnings::Component.new(gaps:, timeframe:)

    / The figures of the comparison beside the cost of the columns as bars, in
      the order of the columns. The savings lead, the savings without PV stand
      smaller beside them, and the savings per 100 km below. The two savings
      share the baseline of their last line, so each label stays close above
      its number. Both sides start at the top, so the head keeps its place
      when the car without PV comes or goes (see WITHOUT_PV_SHIFT).
    section.grid.grid-cols-1.lg:grid-cols-2.gap-6.md:gap-8.p-5.md:p-8.lg:p-0 class=CARD
      - (label, value, color), side, per_100km = figures
      div
        .flex.flex-wrap.items-baseline-last.gap-x-10.gap-y-4
          div
            div class="flex items-center gap-2 #{FIGURE_LABEL} text-sm md:text-base"
              = label
              = render info_icon(savings_notes)
            div class="mt-1 text-4xl md:text-5xl font-bold tabular-nums #{color}" = value
          div class=WITHOUT_PV_FADE
            = small_figure(*side)
        .mt-3 = small_figure(*per_100km)

      - car, without_pv, combustion = columns
      div
        = bar(car)
        div class=WITHOUT_PV_OPEN
          .min-h-0.overflow-hidden
            .pt-4 class=WITHOUT_PV_FADE = bar(without_pv)
        .pt-4 class=WITHOUT_PV_SHIFT = bar(combustion)

    / The calculation of each column, step by step. Without the details, only
      the costs show (see Car::ComparisonColumns::Component#row_class). The
      button below separates it from the chart, so the gap to the chart is
      smaller than between the other sections.
    div class='group/details lg:mb-6' data-car--comparison-page--component-target='details' data-expanded=expanded?
      #comparison-columns data-car--comparison-page--component-target='columns'
        = render calculation

      / The labels of the buttons follow their state, without JavaScript. The
        second adds the car without PV to the comparison or takes it away.
      .mt-3.md:mt-4.flex.flex-wrap.justify-center.gap-3
        button[
          class=PILL_BUTTON
          type='button'
          aria-controls='comparison-columns'
          aria-expanded=expanded?.to_s
          data-car--comparison-page--component-target='button'
          data-action='car--comparison-page--component#toggle'
        ]
          span class='group-data-expanded/details:hidden' = t('.details.show')
          span class='hidden group-data-expanded/details:inline' = t('.details.hide')
          = icon 'chevron-down', class: 'text-xs transition-transform motion-reduce:transition-none group-data-expanded/details:rotate-180'
        = render Car::WithoutPvButton::Component.new(pressed: without_pv?)

    - if charts?
      = render chart
      = render rate_chart
