= helpers.turbo_frame_tag frame_id, src:, loading: :lazy, class: 'flex min-w-0 max-w-full' do
  = link_to helpers.cars_location_path(car: car.id),
            class: link_classes,
            data: { turbo_frame: Car::Location::Component::FRAME_ID } do
    = helpers.icon 'location-dot'
    - if src
      / A placeholder in the size of a short name, until the name comes
      span class='block h-[0.75em] w-[4.5em] rounded-full bg-slate-300 dark:bg-slate-600 animate-pulse motion-reduce:animate-none' aria-hidden='true'
      span.sr-only = t('.location')
    - else
      span.truncate = name || t('.location')
