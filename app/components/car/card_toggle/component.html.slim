/ The two segments are equally wide, so the raised segment slides by its own
  width to the pressed button. It lies below the labels.
.group.relative.inline-grid.grid-cols-2.rounded-lg.bg-slate-100.dark:bg-slate-800.p-1 role='group'
  span.absolute.inset-y-1.left-1.rounded-md.bg-white.shadow-sm.dark:bg-slate-600.transition-transform.duration-250.motion-reduce:transition-none[
    class='w-[calc(50%-0.25rem)] ease-[cubic-bezier(0.32,0.72,0,1)] group-has-[button:last-child[aria-pressed=true]]:translate-x-full'
    aria-hidden='true'
  ]
  - CARDS.each do |name|
    button.relative.px-4.py-1.5.rounded-md.text-sm.font-medium.text-slate-500.dark:text-slate-400.transition-colors.duration-250.aria-pressed:text-slate-800.dark:aria-pressed:text-white.focus-ring[
      type='button'
      aria-pressed=(name == card).to_s
      data-car-cards-target='button'
      data-action='car-cards#show'
      data-car-cards-card-param=name
    ]
      = t("car_breakdown.#{name}")
