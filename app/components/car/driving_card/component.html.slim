= render Car::Card::Component.new(title: t('car_breakdown.driving')) do
  = link_to chart_link_url(distance_sensor_name), class: 'click-animation block min-w-0 text-center focus:outline-none', data: chart_link_data(distance_sensor_name) do
    .text-3xl.md:text-4xl.font-semibold.leading-none.text-slate-700.dark:text-slate-200.whitespace-nowrap
      = render SensorValue::Component.new(balance.car_distance, distance_sensor_name)
    - if balance.car_km_per_day
      .mt-2.md:mt-3.text-sm.md:text-base.text-slate-500.dark:text-slate-400.whitespace-nowrap
        = km_per_day

  / The rows share the height below the distance. Their tooltips open to the
  / left, like the usage column of the power balance.
  .flex-1.flex.flex-col

    = render Car::StatRow::Component.new(title: t('sensors.car_driving_costs'), sensor_name: 'car_driving_costs', timeframe:, large: true, tooltip_placement: 'left', tooltip: Car::DrivingCostTooltip::Component.new(balance:)) do
      - if balance.car_driving_costs
        = render SensorValue::Component.new(balance.car_driving_costs, :total_costs, sign: :negative)
      - else
        = '–'

    = render Car::StatRow::Component.new(title: t('sensors.car_cost_per_100km_short'), sensor_name: rate_chart('car_cost_rate'), timeframe:, large: true, tooltip_placement: 'left', tooltip: (Car::RateTooltip::Component.new(driving: balance.driving, rate: :cost, distance: balance.car_distance) if balance.car_cost_per_100km)) do
      = render SensorValue::Component.new(balance.car_cost_per_100km, :total_costs)

    = render Car::StatRow::Component.new(title: t('sensors.car_consumption_per_100km_short'), sensor_name: rate_chart('car_consumption_rate'), timeframe:, large: true, tooltip_placement: 'left', tooltip: (Car::RateTooltip::Component.new(driving: balance.driving, rate: :consumption, distance: balance.car_distance) if balance.car_consumption_per_100km)) do
      = render SensorValue::Component.new(balance.car_consumption_per_100km&.*(1000), :wallbox_power, context: :total, scaling: :kilo, precision: 1)
