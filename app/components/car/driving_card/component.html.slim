= render Car::Card::Component.new(title: t('car_breakdown.driving')) do
  - tag_name, options = distance_wrapper
  = content_tag tag_name, **options do
    .text-3xl.md:text-4xl.font-semibold.leading-none.text-slate-700.dark:text-slate-200.whitespace-nowrap
      = render SensorValue::Component.new(balance.car_distance, distance_sensor_name)
    - if balance.car_km_per_day
      .mt-2.md:mt-3.text-sm.md:text-base.text-slate-500.dark:text-slate-400.whitespace-nowrap
        = km_per_day

  / The rows share the height below the distance. Their tooltips open to the
  / left, like the usage column of the power balance.
  .flex-1.flex.flex-col

    = render Car::StatRow::Component.new(title: t('sensors.car_driving_costs'), sensor_name: chart_sensor_name('car_driving_costs'), timeframe:, large: true, tooltip_placement: 'left', tooltip: driving_cost_tooltip) do
      - if balance.car_driving_costs
        = render SensorValue::Component.new(balance.car_driving_costs, :total_costs, sign: :negative)
      - else
        = '–'

    = render Car::StatRow::Component.new(title: t('sensors.car_cost_per_100km_short'), sensor_name: chart_sensor_name('car_cost_rate'), timeframe:, large: true, tooltip_placement: 'left', tooltip: (cost_rate_tooltip if balance.car_cost_per_100km)) do
      = render SensorValue::Component.new(balance.car_cost_per_100km, :total_costs)

    = render Car::StatRow::Component.new(title: t('sensors.car_consumption_per_100km_short'), sensor_name: chart_sensor_name('car_consumption_rate'), timeframe:, large: true, tooltip_placement: 'left', tooltip: (consumption_rate_tooltip if balance.car_consumption_per_100km)) do
      = render consumption_value(balance.car_consumption_per_100km)
