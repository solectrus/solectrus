= render Car::Card::Component.new(title: t('car_breakdown.driving')) do
  - tag_name, options = distance_wrapper
  = content_tag tag_name, **options do
    .text-3xl.md:text-4xl.font-semibold.leading-none.text-slate-700.dark:text-slate-200.whitespace-nowrap
      = render Sensor::Value::Component.new(distance, distance_sensor_name)
    - if report.km_per_day
      .sm:mt-2.md:mt-3.text-sm.md:text-base.text-slate-500.dark:text-slate-400.whitespace-nowrap
        = km_per_day

  / The driving cost, its rate, the consumption and the maximum range, one
    below the other in the middle of the card. A rate shows its place in the
    span of its periods. The tooltips open above, so they do not cover the
    charging card. A phone has the width, but not the height, so there the
    rows stand as tiles, two side by side, and closer on a short phone. The
    tiles fill the height that the card has more than it needs.
  .flex-1.flex.flex-col.justify-center.max-sm:grid.max-sm:grid-cols-2.max-sm:gap-3.max-sm:tiny:gap-2
    = render Car::StatRow::Component.new(title: t('car_breakdown.costs'), sensor_name: chart_sensor_name('car_driving_costs'), timeframe:, tooltip: driving_cost_tooltip, css_class: ('max-sm:col-span-2' unless cost_per_100km)) do
      = render Sensor::Value::Component.new(driving_cost, :total_costs)

    - if cost_per_100km
      = render Car::StatRow::Component.new(title: t('car_breakdown.cost_rate'), sensor_name: chart_sensor_name('car_cost_rate'), timeframe:, tooltip: cost_rate_tooltip, bar: cost_rate_bar) do
        = render Sensor::Value::Component.new(cost_per_100km, :total_costs)

    = render Car::StatRow::Component.new(title: t('car_breakdown.consumption_rate'), sensor_name: chart_sensor_name('car_consumption_rate'), timeframe:, tooltip: consumption_rate_tooltip, bar: consumption_bar, css_class: ('max-sm:col-span-2' unless max_range?)) do
      = render consumption_value(consumption_per_100km)

    - if max_range?
      = render Car::StatRow::Component.new(title: t('car_breakdown.range'), sensor_name: max_range_chart, timeframe:, tooltip: max_range_tooltip, bar: max_range_bar) do
        = render Sensor::Value::Component.new(report.max_range, :car_max_range)

  / The visits and their places, like the sessions of the charging card, so
  / the two cards end alike. Only a short phone puts them on one line, because
  / the tiles above take more height than the ring of the charging card.
  - if visits?
    div
      = render Car::SectionTitle::Component.new(title: t('car_breakdown.on_the_road'))
      div class="grid grid-cols-2 gap-3 max-sm:tiny:gap-2 sm:gap-1.5 md:gap-2"
        - visit_badges.each do |label, count, href, data|
          = link_to href, class: badge_classes, data: do
            span.truncate.text-sm.sm:text-xs.md:text-sm.text-slate-500.dark:text-slate-400
              = label
            span.text-lg.sm:text-sm.md:text-base.font-semibold.tabular-nums.text-slate-700.dark:text-slate-300
              = count
