= render Ui::TitleBar::Component.new(title:, **back) do |bar|
  - bar.with_action(**add, icon: 'plus') if add

/ The desktop has the way back, the lists or the title, and the timeframe
.hidden.lg:flex.relative.items-center.justify-between.py-5
  .flex.items-center.gap-2
    = render Car::BackLink::Component.new(path: desktop_back)
    - if tabs.any?
      = render Nav::Sub::Component.new(abbreviate: false) do |c|
        - c.with_items tabs
    - else
      h1.px-2.text-lg.font-medium.uppercase.tracking-wider.text-white.dark:text-gray-300
        = title

  / The button for a new entry and the select of the car stand before the
    timeframe, in the order of the keyboard too
  .flex.items-center.gap-4
    - if add
      = render Ui::AddButton::Component.new(**add)
    - if car_select?
      = header_car_select
    .flex.min-w-0.items-center.h-8
      = timeframe
