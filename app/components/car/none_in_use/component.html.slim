- if gauge?
  .flex.flex-col.items-center.text-center class='gap-[clamp(0.75rem,4cqi,1.25rem)] px-[12%]'
    .flex.items-center.justify-center.rounded-full.bg-slate-100.dark:bg-slate-800 class='size-[clamp(3.5rem,20cqi,6rem)]'
      = helpers.icon 'car', class: 'text-slate-400 dark:text-slate-500 text-[clamp(1.5rem,9cqi,2.75rem)]'
    span.text-slate-600.dark:text-slate-300.font-medium class='text-[clamp(1rem,4.5cqi,1.375rem)]'
      = text
    = edit_link
- else
  = render Ui::EmptyState::Component.new(icon: 'car', title: text) do
    = edit_link
