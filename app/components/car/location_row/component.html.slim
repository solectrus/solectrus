/ The place at the right, with the town and the age of the position below it
  on the road
= helpers.turbo_frame_tag frame_id, src:, loading: :lazy, class: 'grid' do
  = content_tag tag_name, **link_options, class: row_classes do
    span.shrink-0 = t('.location')
    span.flex.min-w-0.items-center.gap-2
      = render Place::Icon::Component.new(place:, round: true)
      span.min-w-0.text-right.text-fg-secondary
        / A placeholder in the size of a short name, until the name comes
        - if src
          span class='inline-block align-middle h-3.5 w-24 rounded-full bg-fill-strong animate-pulse motion-reduce:animate-none' aria-hidden='true'
        span.block.truncate class=('sr-only' if src)
          = title
        - if subtitle.present?
          span.block.truncate.text-sm.text-muted.tabular-nums
            = subtitle
      - if location
        = helpers.icon 'chevron-right', class: 'shrink-0 text-xs text-faint'
