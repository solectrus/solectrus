= helpers.turbo_frame_tag FRAME_ID do
  / The whole window, like a zoomed chart. On a phone, the map reaches the
    edges of the window. A modal dialog lies over each part of the page, also
    over a part with a stacking context of its own, like the head of a phone.
    It takes the focus itself, so the close button shows no ring.
  dialog[
    class='fixed inset-0 m-0 size-full max-w-none max-h-none border-0 pt-4 sm:p-6 open:flex flex-col gap-4 bg-white dark:bg-slate-900'
    aria-label=title
    autofocus=true
    data-controller='car--map-overlay--component'
    data-action='cancel->car--map-overlay--component#cancel'
  ]
    .relative.flex.items-center.justify-center.min-h-10.mx-4.sm:mx-0.px-12
      - if head?
        = head
      - else
        h2.text-base.sm:text-lg.font-semibold.truncate.text-fg = title

      button[
        class='absolute right-0 top-0 flex items-center justify-center size-10 rounded-full cursor-pointer bg-fill hover:bg-fill-strong text-fg-secondary focus-ring'
        type='button'
        data-action='car--map-overlay--component#close'
        data-controller='tooltip'
        title=t('.close')
        aria-label=t('.close')
      ]
        = helpers.icon 'xmark', class: 'fa-lg'

    .flex-1.min-h-0.flex.flex-col class='max-sm:*:rounded-none'
      = content
