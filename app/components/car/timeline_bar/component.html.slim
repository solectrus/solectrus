/ The segments stack from the bottom up, PV first. Side by side, they would
  read as one after the other in time. The areas of a curve take their
  place. A pause lies over them, in the time in which the car stayed
  plugged in but did not charge.
= tag.div(**attributes) do
  - if bar.areas.any?
    svg.absolute.inset-0.size-full viewBox='0 0 1000 100' preserveAspectRatio='none' aria-hidden='true'
      - bar.areas.each do |area|
        path d=area.last style="fill: #{area.first}"
  - else
    - segments.each do |segment|
      span.basis-0 style="flex-grow: #{segment.last}; background: #{segment.first}"
  - bar.pauses.each do |left, width|
    span.absolute.inset-y-0.bg-car-plugged style="left: #{left}%; width: #{width}%"
  / A click opens the entry: in the modal on the desktop, in a sheet on a
    phone
  - if bar.href
    = link_to '', bar.href, class: 'max-lg:hidden absolute inset-0 focus-ring', aria: { label: bar.label }, data: Ui::TurboModal::Component.link_data
    = link_to '', bar.sheet_href || bar.href, class: 'lg:hidden absolute inset-0 focus-ring', aria: { label: bar.label }, data: Ui::TurboModal::Component.link_data
  = render tooltip
