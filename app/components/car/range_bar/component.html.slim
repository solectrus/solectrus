div class="flex-1 w-full max-w-md flex flex-col items-center justify-center gap-5 @container text-slate-700 dark:text-slate-300"
  / The block above the bar, for example the name of the car and its
    odometer
  = content

  .w-full
    / The range on the left, the state of charge on the right. Without a
      range, the state of charge takes its place.
    .flex.items-center.justify-between.gap-3
      - if range?
        = value_tag(:range, class: 'flex items-baseline gap-2 min-w-0 rounded-md') do
          span.font-medium.tabular-nums.leading-none.text-3xl
            = render Sensor::Value::Component.new(range, sensor_name(:car_range))
          / An estimate names itself, and its tooltip tells where it comes from
          span.truncate.text-xs.uppercase.tracking-wide.text-slate-500.dark:text-slate-400 title=(t('cars.battery.estimated_note') if estimated?) data-controller=('tooltip' if estimated?)
            = estimated? ? t('cars.battery.estimated') : t('sensors.car_range_short')

      - if soc
        = value_tag(:soc, class: class_names('shrink-0 rounded-full px-3 py-0.5 font-semibold tabular-nums', badge_class, range? ? 'text-base' : 'text-2xl'), title: t('sensors.car_battery_soc_short'), aria: { label: t('sensors.car_battery_soc_short') }, data: { controller: 'tooltip' }) do
          = "#{soc.round} %"

      - if stale?
        div class='rounded-full px-3 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-sm'
          = t('cars.battery.stale')

    / The bar stays gray without a state of charge, and else blue (see
      --color-car-battery). While the car charges, the part that the charge
      fills next pulses.
    .relative.mt-3.h-3.rounded-full.overflow-hidden.bg-slate-200.dark:bg-slate-800 aria-hidden='true'
      - if soc&.positive?
        .absolute.inset-y-0.left-0.bg-car-battery style="width: #{fill_percent}%"
      - if charging_segment
        .charging-pulse.absolute.inset-y-0.bg-car-battery style="left: #{fill_percent}%; width: #{charging_segment}%"

    / The scale from 0 to the maximum range at the ends of the bar, and
      between them the plug and the charging power
    - if scale? || wallbox?
      div class="mt-2 grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 text-base text-slate-500 dark:text-slate-400"
        span.whitespace-nowrap
          - if scale?
            = render Sensor::Value::Component.new(0, sensor_name(:car_range))

        .flex.justify-center.min-w-0
          - if wallbox?
            = render Car::WallboxBadge::Component.new(state:, size: :bar)

        - if max_range
          span.whitespace-nowrap.text-right title=t('sensors.car_max_range_short') aria-label=t('sensors.car_max_range_short') data-controller='tooltip'
            = render Sensor::Value::Component.new(max_range, sensor_name(:car_max_range))
