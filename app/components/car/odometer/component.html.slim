/ The unit hangs outside, so the digits alone stand in the center
.relative.flex.items-center.gap-1
  - digits.each do |digit|
    span.flex.items-center.justify-center.w-7.h-10.md:w-8.md:h-11.rounded-md.font-mono.text-2xl.md:text-3xl class=digit_classes
      = digit
  span class=class_names('absolute left-full top-1/2 -translate-y-1/2 ml-1.5 text-lg', active? ? 'text-slate-500 dark:text-slate-400' : 'text-slate-300 dark:text-slate-600') km
