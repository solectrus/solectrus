/ Each row draws the separator below it and reaches 1px into the next one,
  so the card cuts off the separator of the last row. The separator lies on
  the body, not on the row, so it starts after the icon.
li.-mb-px data=row_data
  = content_tag tag_name, **tag_options do
    - if icon_name
      span.flex.size-8.shrink-0.items-center.justify-center.rounded-lg.bg-gray-200.text-gray-500.dark:bg-slate-700.dark:text-slate-400
        = icon(icon_name, class: 'text-base')
    .flex.min-h-14.min-w-0.flex-1.items-center.gap-3.border-b.border-gray-300/70.py-2.5.pr-4.dark:border-slate-700
      - if detail
        .min-w-0.flex-1
          .truncate.text-headline class=name_class = name
          .text-sm.text-gray-500.dark:text-slate-400 = detail
      - else
        .min-w-0.flex-1.truncate.text-headline class=name_class = name
      - if badge_count&.positive?
        span.flex.h-5.min-w-5.items-center.justify-center.rounded-full.bg-red-500.px-1.5.text-xs.font-bold.text-white.dark:bg-red-700.dark:text-gray-300[
          data-notification-badge=true
        ]
          = badge_count
      - if dot
        span.block.size-2.5.rounded-full.bg-amber-400.dark:bg-amber-500 aria-hidden='true'
      = accessory
      - if trailing_icon
        = icon(trailing_icon, class: trailing_icon_class)
