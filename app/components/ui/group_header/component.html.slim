/ The first header of a phone stands close to the card above
h3.ui-group-header.col-span-full.px-2.pt-6.pb-2.text-sm.font-semibold.uppercase.tracking-wide.text-gray-700.dark:text-slate-300.max-lg:px-4.max-lg:pb-1.5.max-lg:first:pt-0
  - if href
    = link_to href, class: 'inline-flex items-center gap-1.5 -mx-1 px-1 rounded-sm focus-ring lg:hover:text-gray-950 dark:lg:hover:text-white max-lg:active:opacity-60' do
      = title
      = icon 'chevron-right', class: 'text-xs'
  - else
    = title
