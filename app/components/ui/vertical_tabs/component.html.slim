/ A morph after a save leaves a permanent element as it is, even without an
  id, so the selected tab stays
.flex.flex-col.md:flex-row data-controller='ui--vertical-tabs--component' data-turbo-permanent=true
  nav.-mx-6.mb-4.bg-gray-100.dark:bg-gray-800.px-6.md:pl-0.md:mr-8.md:pr-5.md:bg-inherit.md:dark:bg-inherit.md:mx-0.md:border-r.sticky.top-0.z-10
    ul.flex.justify-between.md:space-y-1.md:flex-col.-mx-2.md:mx-0.text-sm.md:text-base.font-medium.uppercase.tracking-wider role='tablist'
      - tabs.each_with_index do |tab, index|
        li role='presentation'
          a[
            id=tab_id(tab)
            href="##{tab.id}"
            class=TAB_CLASS
            role='tab'
            aria-controls=tab.id
            aria-selected=index.zero?.to_s
            data-action='click->ui--vertical-tabs--component#select'
            data-ui--vertical-tabs--component-target='tab'
          ]
            = tab.label

  .flex-1
    - tabs.each_with_index do |tab, index|
      div[
        id=tab.id
        role='tabpanel'
        aria-labelledby=tab_id(tab)
        hidden=!index.zero?
        data-ui--vertical-tabs--component-target='panel'
      ]
        = tab
