.ui-title-bar.lg:hidden.-mx-4.sm:-mx-6.px-4.sm:px-6.py-3[
  class=('ui-title-bar-plain' if plain)
  data-controller='ui--title-bar--component'
  data-action='turbo:click@document->ui--title-bar--component#slide turbo:before-fetch-request@document->ui--title-bar--component#hold turbo:before-render@document->ui--title-bar--component#prepare'
  data-path=helpers.request.path
  data-parent=parent_path
]
  / The bar behind the title bar and its accessories, which takes the height
    of the next page during the slide (see component.css). It starts below
    the Theme::Strip, which must stay uncovered.
  .ui-title-bar-backdrop.absolute.inset-x-0.bottom-0.-z-10.visible.bg-chrome class='top-(--theme-strip-height)' aria-hidden='true'
  .relative.flex.items-center.justify-center.min-h-10
    - if back_href
      = link_to back_href,
                class: 'ui-title-bar-back left-0 click-animation',
                data: back_data,
                title: back_label,
                'aria-label': back_label do
        = icon 'chevron-left'
    - else
      /! Placeholder, which the skeleton of a child page shows as its back button
      span.ui-title-bar-back.left-0.invisible aria-hidden='true'
        = icon 'chevron-left'
    h1.px-12.truncate.font-medium.text-lg.text-white.dark:text-gray-200
      - if logo
        = image_tag logo, alt: title, class: 'ui-title-bar-logo'
      - else
        = title
    = action || save
