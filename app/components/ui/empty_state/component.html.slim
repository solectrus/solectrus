.flex.flex-1.flex-col.items-center.justify-center.px-4.py-12.text-center class=classes(:root)
  .flex.shrink-0.items-center.justify-center.rounded-full.bg-fill class=classes(:circle) aria-hidden='true'
    - if slashed?
      = helpers.slashed_icon icon_name, class: "text-faint #{classes(:icon)}"
    - else
      = helpers.icon icon_name, class: "text-faint #{classes(:icon)}"
  p.max-w-prose.text-fg-secondary class=classes(:title)
    = title
  - if text
    p.max-w-prose.text-muted class=classes(:text)
      = text
  - if content.present?
    .mt-2
      = content
