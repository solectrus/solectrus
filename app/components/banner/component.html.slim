/ Over the ThemeStrip, which lies at the top edge of the viewport and would
  cover this banner, because the banner is the first thing on the page.
.relative.z-10.bg-amber-200.dark:bg-pink-700.p-3.text-indigo-800.dark:text-pink-200.text-xs.md:text-base
  .max-w-screen-xl.3xl:max-w-screen-2xl.mx-auto.sm:px-6.lg:px-8
    .flex.justify-between.items-center.gap-2
      - if admin
        .flex.items-center
          = render Button::Component.new( \
              path: registration_path(status: 'snooze'),
              icon: 'xmark',
              style: :tertiary,
              options: { class: 'text-gray-500 dark:text-pink-100/50 text-lg', data: { turbo_prefetch: false } },
            )

          - if pending?
            = t('.pending')

          - elsif unregistered?
            = t('.unregistered')

        = render Button::Component.new( \
            path: registration_path,
            title: t('.button_to_register'),
            icon: 'id-card',
            options: { data: { turbo: 'false' } },
          )

      - else
        = t('.login_to_register')

        = render Button::Component.new( \
            path: new_session_path,
            title: t('layout.login'),
          )
