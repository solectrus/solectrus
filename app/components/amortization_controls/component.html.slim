= helpers.form_with url: helpers.amortization_path, method: :patch, data: { controller: 'amortization-controls--component auto-submit', turbo_frame: 'amortization_detail' } do
  / Re-render the same view the sliders live on (chart or details)
  - if details_view?
    = hidden_field_tag :view, 'details'
  div class=wrapper_class
    div class="form-control #{control_class}"
      .flex.justify-between.items-baseline.gap-2.py-1.text-sm
        span class=caption_class = t('.period')
        span class="font-semibold tabular-nums whitespace-nowrap #{value_class}"
          span data-amortization-controls--component-target='periodValue'
            = period_years
          = " #{t('.years_unit')}"
      input[
        class=slider_class
        type='range'
        name='amortization[period_years]'
        min=period_min max=period_max step=1 value=period_years
        aria-label=t('.period')
        data-amortization-controls--component-target='periodInput'
        data-action='input->amortization-controls--component#updatePeriod change->auto-submit#submit'
      ]

    div class="form-control #{control_class}"
      .flex.justify-between.items-baseline.gap-2.py-1.text-sm
        span class=caption_class = t('.interest_rate')
        span class="font-semibold tabular-nums whitespace-nowrap #{value_class}"
          span data-amortization-controls--component-target='rateValue'
            = rate_label
          | &nbsp;%
      input[
        class=slider_class
        type='range'
        name='amortization[interest_rate]'
        min=interest_min max=interest_max step=interest_step value=interest_rate
        aria-label=t('.interest_rate')
        data-amortization-controls--component-target='rateInput'
        data-action='input->amortization-controls--component#updateRate change->auto-submit#submit'
      ]
