/ Laid out like an empty place of the app (Ui::EmptyState::Component): the
  feature is missing here, and the text says why and how to get it.
= render Ui::EmptyState::Component.new(icon: 'lock', title: t('title', scope: ".#{feature}"), text: t('description', scope: ".#{feature}")) do
  .flex.max-w-prose.flex-col.items-center.gap-6
    / Every visitor sees the offer of the free month, admin or not: whoever
      cannot start it can still tell the person who can. It says where the
      month starts, but gets no button, because the registration page turns
      away everyone without the admin session.
    p.text-sm.text-muted.md:text-base
      = t('.sponsoring_only')

    - if PremiumStatus.trial_available?
      p.rounded-lg.bg-attention-soft.px-4.py-3.text-sm.text-attention-strong.md:text-base
        == t('.trial_hint_html')

    .flex.flex-col.items-center.justify-center.gap-4.sm:flex-row.sm:gap-8
      - if demo_url
        = render Ui::Button::Component.new label: t('.demo'),
                                           icon: 'arrow-up-right-from-square',
                                           href: demo_url,
                                           target: '_blank',
                                           style: :primary

      = render Ui::Button::Component.new label: t('.about_sponsoring'),
                                         href: sponsoring_path,
                                         data: { turbo: false },
                                         style: :secondary
