.flex.flex-col.gap-2
  - if projection_uncertain
    .flex.justify-center
      span.inline-flex.items-center.gap-2.rounded-full.bg-amber-100.dark:bg-amber-900.px-3.py-1.text-xs.font-medium.text-amber-800.dark:text-amber-200
        i.fa.fa-circle-exclamation
        = t('.uncertain_prognosis')

  / Amortization degree, net position and nominal surplus are shown as
  / annotations on the chart. The canvas has no text, so keep them in the DOM for
  / screen readers (and the specs) - visually hidden to avoid duplicating the
  / chart.
  .sr-only
    p = "#{t('.degree')}: #{degree_text}"
    p = "#{t('.net_position')}: #{currency(net_position)}"
    p = "#{t('.profit_nominal')}: #{currency(profit_nominal)}"

  / Secondary KPI rail: the figures that are not on the chart. On very short
  / viewports the whole rail is hidden by the parent (tiny:sr-only).
  .grid.grid-cols-3.gap-2.md:gap-3.text-center
    /! Net present value - key figure for comparing with an investment
    div class=stat_tile_class
      div class=stat_label_class
        = t('.npv')
        = info_icon npv_hint
      div class="#{stat_value_class} #{signed_color(npv)}"
        = currency(npv)

    /! Internal rate of return
    div class=stat_tile_class
      div class=stat_label_class
        = t('.irr')
        = info_icon t('.irr_hint')
      div class="#{stat_value_class} #{signed_color(irr_percent)}"
        = percentage(irr_percent)

    div class=stat_tile_class
      div class=stat_label_class
        = t('.savings_per_year')
        = info_icon savings_per_year_hint
      div class="#{stat_value_class} #{signed_color(savings_per_year)}"
        - if savings_per_year
          = link_to currency(savings_per_year), balance_home_path(sensor_name: 'savings', timeframe: 'P365D'), class: 'hover:underline'
        - else
          = currency(savings_per_year)
