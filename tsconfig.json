{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./app/frontend/*"]
    },
    "types": ["vite/client"],

    // Vite transpiles each file on its own, without the type information of
    // the others. These two options make tsc reject what that cannot handle,
    // and keep a type-only import out of the bundle.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["app/frontend/**/*.ts", "app/components/**/*.ts"]
}
